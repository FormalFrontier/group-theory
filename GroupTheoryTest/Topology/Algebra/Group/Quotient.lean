/-!
# Left-coset fibers and strict left-translation examples

The generic clients use canonical singleton fibers, open and closed subgroups,
and continuous observers on the quotient. A closed finite-index subgroup gives a
discrete quotient and hence continuity of every observer, with no compactness
assumption or explicit openness premise. Agreement with Mathlib's stronger
separately continuous API uses the same subgroup, topology and canonical quotient,
without new public wrappers or definitions.

The concrete example gives existing additive integers their cofinite topology
before taking `Multiplicative ℤ`, and multiplies that group with discrete
`Equiv.Perm (Fin 3)`. The subgroup is the whole integer factor times the cyclic
subgroup generated by `(01)`. Supporting proof terms for openness, properness,
nonnormality and index three, and for ambient compactness, infinitude,
non-Hausdorffness and failure of joint multiplication, do not use the library's
subgroup/quotient results.
Fixed right translations and inversion are also continuous in this example: it
is not a strict separation of left from both-sided constant continuity.

A second example changes only the permutation topology: it is induced by the
canonical left-coset projection to an explicitly discrete auxiliary target.
This topology has all left translations continuous but right translation by
`(12)`, inversion and joint multiplication discontinuous. Its product with the
same cofinite integer factor retains these strict boundaries and the open,
proper, nonnormal index-three subgroup. The construction's explicit input is
kept separate from the canonical coinduced quotient topology used by the library
statements; the latter's discreteness is checked as a consequence. Independent
closedness witnesses use the closed identity singleton of the auxiliary discrete
target, and then its inverse image under the second product projection. The
algebraic index-three witnesses give finite index independently of compactness.
The closed/T1 and finite-index clopen APIs apply to both the finite permutation
example and the infinite product, despite their failure of right continuity,
inversion continuity, joint multiplication and T0 separation.

A primitive two-shift action of `Bool` on the same cofinite multiplicative
integers has neither scalar operator equal to the identity. The stock Option
action is used with the topology coinduced by `some`; the inclusion is a
nonsurjective open embedding and retains the nondiscrete source topology.

Two further canonical quotients retain the strict partition source topology.
The quotient of the permutation group by bottom is non-T1 and nondiscrete. In
the infinite product, the subgroup bottom times the two-element cyclic subgroup
is finite, nonnormal and nonopen. Its quotient is infinite and nondiscrete, as
witnessed by the quotient-map observer recording the first coordinate. Fixed
quotient translations are tested only after these independent boundary facts;
nonidentity integer shifts give nontrivial observed movement.

## References

Mathlib supplies the cofinite topology, its compactness and irreducibility,
unchanged multiplicative type-tag topology, subgroup products, cyclic subgroups,
finite permutation cardinality, coset fibers and subgroup index formulas.
-/

open scoped Topology Pointwise

namespace GroupTheoryTest.Topology.Algebra.Group.Quotient

universe u v

section Generic

variable {G : Type u} [Group G] [TopologicalSpace G]

-- The characteristic fiber uses the existing quotient, not a quotient-group map.
omit [TopologicalSpace G] in
private theorem singleton_fiber (H : Subgroup G) (g : G) :
    (QuotientGroup.mk : G → G ⧸ H) ⁻¹' {QuotientGroup.mk g} = g • (H : Set G) := by
  simpa only [Set.preimage, Set.mem_singleton_iff] using
    QuotientGroup.eq_class_eq_leftCoset H g

private theorem singleton_open_iff_fiber_open (H : Subgroup G) (g : G) :
    IsOpen ({QuotientGroup.mk g} : Set (G ⧸ H)) ↔
      IsOpen ((QuotientGroup.mk : G → G ⧸ H) ⁻¹' {QuotientGroup.mk g}) := by
  exact (QuotientGroup.isQuotientMap_mk H).isCoinducing.isOpen_preimage.symm

omit [TopologicalSpace G] in
private theorem mem_singleton_fiber (H : Subgroup G) (g x : G) :
    x ∈ (QuotientGroup.mk : G → G ⧸ H) ⁻¹' {QuotientGroup.mk g} ↔
      g⁻¹ * x ∈ H := by
  rw [singleton_fiber]
  exact mem_leftCoset_iff g

private theorem open_singleton_fiber [ContinuousConstSMul G G] (H : Subgroup G)
    (hH : IsOpen (H : Set G)) (g : G) :
    IsOpen ((QuotientGroup.mk : G → G ⧸ H) ⁻¹' {QuotientGroup.mk g}) := by
  rw [singleton_fiber]
  exact hH.smul g

-- A consequence for arbitrary quotient observers, not a restatement of the iff.
private theorem continuous_quotient_observer [ContinuousConstSMul G G]
    (H : Subgroup G) (hH : IsOpen (H : Set G))
    {Y : Type v} [TopologicalSpace Y] (f : G ⧸ H → Y) : Continuous f := by
  let : DiscreteTopology (G ⧸ H) := (H.isOpen_iff_discreteTopology_quotient).mp hH
  exact continuous_of_discreteTopology

private theorem finite_coset_type [ContinuousConstSMul G G] [CompactSpace G]
    (H : Subgroup G) (hH : IsOpen (H : Set G)) : Finite (G ⧸ H) := by
  exact H.finiteIndex_iff_finite_quotient.mp (H.finiteIndex_of_isOpen hH)

private theorem coset_card_ne_zero [ContinuousConstSMul G G] [CompactSpace G]
    (H : Subgroup G) (hH : IsOpen (H : Set G)) : Nat.card (G ⧸ H) ≠ 0 := by
  exact (H.finiteIndex_of_isOpen hH).index_ne_zero

-- Both bridges keep precisely the same subgroup, quotient, topology and conclusion.
-- The conclusion is a proposition, so equality of proof terms is proof irrelevance.
private theorem mathlib_discreteness_agreement [SeparatelyContinuousMul G]
    (H : Subgroup G) :
    H.isOpen_iff_discreteTopology_quotient =
      (QuotientGroup.discreteTopology_iff (N := H)).symm := by
  exact Subsingleton.elim _ _

private theorem mathlib_finiteIndex_agreement [SeparatelyContinuousMul G] [CompactSpace G]
    (H : Subgroup G) (hH : IsOpen (H : Set G)) :
    H.finiteIndex_of_isOpen hH =
      (by
        let : Finite (G ⧸ H) := Subgroup.quotient_finite_of_isOpen H hH
        exact Subgroup.finiteIndex_of_finite_quotient : H.FiniteIndex) := by
  exact Subsingleton.elim _ _

private theorem singleton_closed_iff_fiber_closed (H : Subgroup G) (g : G) :
    IsClosed ({QuotientGroup.mk g} : Set (G ⧸ H)) ↔
      IsClosed ((QuotientGroup.mk : G → G ⧸ H) ⁻¹' {QuotientGroup.mk g}) := by
  exact (QuotientGroup.isQuotientMap_mk H).isCoinducing.isClosed_preimage.symm

private theorem closed_singleton_fiber [ContinuousConstSMul G G] (H : Subgroup G)
    (hH : IsClosed (H : Set G)) (g : G) :
    IsClosed ((QuotientGroup.mk : G → G ⧸ H) ⁻¹' {QuotientGroup.mk g}) := by
  rw [singleton_fiber]
  exact hH.smul g

private theorem closed_quotient_singleton [ContinuousConstSMul G G] (H : Subgroup G)
    (hH : IsClosed (H : Set G)) (q : G ⧸ H) : IsClosed ({q} : Set (G ⧸ H)) := by
  let : T1Space (G ⧸ H) := (H.isClosed_iff_t1Space_quotient).mp hH
  exact isClosed_singleton

private theorem open_subgroup_closed_and_clopen [ContinuousConstSMul G G]
    (H : Subgroup G) (hH : IsOpen (H : Set G)) :
    IsClosed (H : Set G) ∧ IsClopen (H : Set G) := by
  have hclopen := (H.isClopen_iff_isOpen).mpr hH
  exact ⟨hclopen.isClosed, hclopen⟩

-- Closedness and finite index suffice for observers with an independent universe.
private theorem continuous_closed_finiteIndex_quotient_observer [ContinuousConstSMul G G]
    (H : Subgroup G) [H.FiniteIndex] (hH : IsClosed (H : Set G))
    {Y : Type v} [TopologicalSpace Y] (f : G ⧸ H → Y) : Continuous f := by
  have hopen : IsOpen (H : Set G) := (H.isOpen_iff_isClosed).mpr hH
  let : DiscreteTopology (G ⧸ H) := (H.isOpen_iff_discreteTopology_quotient).mp hopen
  exact continuous_of_discreteTopology

-- Equality is between proposition-valued proofs about the same canonical objects.
private theorem mathlib_closed_t1_agreement [SeparatelyContinuousMul G]
    (H : Subgroup G) :
    H.isClosed_iff_t1Space_quotient = (QuotientGroup.t1Space_iff (N := H)).symm := by
  exact Subsingleton.elim _ _

private theorem mathlib_closed_finiteIndex_open_agreement [SeparatelyContinuousMul G]
    (H : Subgroup G) [H.FiniteIndex] (hH : IsClosed (H : Set G)) :
    (H.isOpen_iff_isClosed).mpr hH = H.isOpen_of_isClosed_of_finiteIndex hH := by
  exact Subsingleton.elim _ _

private theorem mathlib_open_closed_agreement [SeparatelyContinuousMul G]
    (H : Subgroup G) (hH : IsOpen (H : Set G)) :
    ((H.isClopen_iff_isOpen).mpr hH).isClosed = H.isClosed_of_isOpen hH := by
  exact Subsingleton.elim _ _

private theorem canonical_fixed_action [ContinuousConstSMul G G]
    (H : Subgroup G) (g : G) : Continuous (fun q : G ⧸ H => g • q) := by
  exact continuous_const_smul g

private theorem projection_hom_coercion (H : Subgroup G) :
    (MulActionHom.toQuotient H : G → G ⧸ H) = QuotientGroup.mk := by
  rfl

private theorem projection_hom_continuous (H : Subgroup G) :
    Continuous (MulActionHom.toQuotient H : G → G ⧸ H) := by
  exact QuotientGroup.continuous_mk

private theorem projection_transport_full [ContinuousConstSMul G G]
    (H : Subgroup G) (g : G) : Continuous (fun q : G ⧸ H => g • q) := by
  let : ContinuousConstSMul G (G ⧸ H) :=
    Topology.IsCoinducing.continuousConstSMul (MulActionHom.toQuotient H)
      (QuotientGroup.isQuotientMap_mk H).isCoinducing
  exact continuous_const_smul g

private theorem projection_transport_dot [ContinuousConstSMul G G]
    (H : Subgroup G) (g : G) : Continuous (fun q : G ⧸ H => g • q) := by
  let : ContinuousConstSMul G (G ⧸ H) :=
    (QuotientGroup.isQuotientMap_mk H).isCoinducing.continuousConstSMul
      (MulActionHom.toQuotient H)
  exact continuous_const_smul g

private theorem projection_semiconj (H : Subgroup G) (g : G) :
    Function.Semiconj (QuotientGroup.mk : G → G ⧸ H)
      (fun x : G => g * x) (fun q : G ⧸ H => g • q) := by
  intro x
  exact (MulAction.Quotient.smul_mk H g x).symm

private theorem projection_map_smul (H : Subgroup G) (g x : G) :
    MulActionHom.toQuotient H (g • x) = g • MulActionHom.toQuotient H x := by
  exact map_smul (MulActionHom.toQuotient H) g x

private theorem canonical_action_laws (H : Subgroup G) (g h : G) (q : G ⧸ H) :
    (1 : G) • q = q ∧ (g * h) • q = g • h • q := by
  exact ⟨one_smul G q, mul_smul g h q⟩

private theorem fixed_action_observer [ContinuousConstSMul G G]
    (H : Subgroup G) {Y : Type v} [TopologicalSpace Y]
    (f : G ⧸ H → Y) (hf : Continuous f) (g : G) :
    Continuous (fun q : G ⧸ H => f (g • q)) := by
  exact hf.comp (canonical_fixed_action H g)

private theorem fixed_action_homeomorph [ContinuousConstSMul G G]
    (H : Subgroup G) (g : G) (q : G ⧸ H) :
    Continuous (Homeomorph.smul (α := G ⧸ H) g) ∧
      (Homeomorph.smul (α := G ⧸ H) g).symm
        (Homeomorph.smul (α := G ⧸ H) g q) = q := by
  exact ⟨(Homeomorph.smul g).continuous, (Homeomorph.smul g).symm_apply_apply q⟩

private theorem canonical_stabilizer (H : Subgroup G) :
    MulAction.stabilizer G (QuotientGroup.mk (1 : G) : G ⧸ H) = H := by
  exact MulAction.stabilizer_quotient H

private theorem mathlib_fixed_action_agreement [SeparatelyContinuousMul G]
    (H : Subgroup G) :
    QuotientGroup.continuousConstSMul H =
      (QuotientGroup.instContinuousConstSMul (N := H) : ContinuousConstSMul G (G ⧸ H)) := by
  exact QuotientGroup.continuousConstSMul_eq H

end Generic

section Additive

variable {G : Type u} [AddGroup G] [TopologicalSpace G]

private theorem additive_fixed_action [ContinuousConstVAdd G G]
    (H : AddSubgroup G) (g : G) : Continuous (fun q : G ⧸ H => g +ᵥ q) := by
  exact continuous_const_vadd g

private theorem additive_projection_semiconj (H : AddSubgroup G) (g : G) :
    Continuous (QuotientAddGroup.mk : G → G ⧸ H) ∧
      Function.Semiconj (QuotientAddGroup.mk : G → G ⧸ H)
        (fun x : G => g + x) (fun q : G ⧸ H => g +ᵥ q) := by
  refine ⟨QuotientAddGroup.continuous_mk, ?_⟩
  intro x
  exact (AddAction.Quotient.vadd_mk H g x).symm

private theorem additive_observer [ContinuousConstVAdd G G]
    (H : AddSubgroup G) {Y : Type v} [TopologicalSpace Y]
    (f : G ⧸ H → Y) (hf : Continuous f) (g : G) :
    Continuous (fun q : G ⧸ H => f (g +ᵥ q)) := by
  let : ContinuousConstVAdd G (G ⧸ H) := QuotientAddGroup.continuousConstVAdd H
  exact hf.comp (continuous_const_vadd g)

private theorem mathlib_fixed_addition_agreement [SeparatelyContinuousAdd G]
    (H : AddSubgroup G) :
    QuotientAddGroup.continuousConstVAdd H =
      (QuotientAddGroup.instContinuousConstVAdd (N := H) : ContinuousConstVAdd G (G ⧸ H)) := by
  exact QuotientAddGroup.continuousConstVAdd_eq H

end Additive

section CofiniteProduct

-- The topology is selected on the existing additive group, not on an algebraically
-- transported WithTopology wrapper. No standard discrete integer topology is used.
local instance : TopologicalSpace ℤ := TopologicalSpace.cofinite

private abbrev A := Multiplicative ℤ
private abbrev P := Equiv.Perm (Fin 3)
private abbrev M := A × P

local instance : TopologicalSpace P := ⊥
local instance : DiscreteTopology P := discreteTopology_bot P

private abbrev tau : P := Equiv.swap (0 : Fin 3) (1 : Fin 3)
private abbrev sigma : P := Equiv.swap (1 : Fin 3) (2 : Fin 3)
private abbrev K : Subgroup P := Subgroup.zpowers tau
private abbrev H : Subgroup M := (⊤ : Subgroup A).prod K

local instance : CompactSpace ℤ :=
  Function.Surjective.compactSpace
    (WithTopology.continuous_ofTopology (X := ℤ) (t := TopologicalSpace.cofinite))
    (WithTopology.ofTopology_surjective TopologicalSpace.cofinite)

private theorem model_compact : CompactSpace M := inferInstance

private theorem model_infinite : Infinite M := inferInstance

-- A model-local cofinite fact, not a new public topology/action engine.
private theorem cofinite_integer_injection_continuous (f : ℤ → ℤ)
    (hf : Function.Injective f) : Continuous f := by
  refine continuous_def.mpr ?_
  intro s hs
  change s.Nonempty → sᶜ.Finite at hs
  change (f ⁻¹' s).Nonempty → (f ⁻¹' s)ᶜ.Finite
  rintro ⟨x, hx⟩
  simpa only [Set.preimage_compl] using
    Set.Finite.preimage hf.injOn (hs ⟨f x, hx⟩)

private theorem left_translation_continuous (g : M) :
    Continuous (fun x : M => g * x) := by
  have ha : Continuous (fun x : A => g.1 * x) :=
    continuous_ofAdd.comp
      ((cofinite_integer_injection_continuous (fun n => g.1.toAdd + n)
        (fun _ _ h => add_left_cancel h)).comp continuous_toAdd)
  have hp : Continuous (fun x : P => g.2 * x) := continuous_of_discreteTopology
  exact (ha.comp continuous_fst).prodMk (hp.comp continuous_snd)

local instance : ContinuousConstSMul M M where
  continuous_const_smul g := left_translation_continuous g

private theorem right_translation_continuous (g : M) :
    Continuous (fun x : M => x * g) := by
  have ha : Continuous (fun x : A => x * g.1) :=
    continuous_ofAdd.comp
      ((cofinite_integer_injection_continuous (fun n => n + g.1.toAdd)
        (fun _ _ h => add_right_cancel h)).comp continuous_toAdd)
  have hp : Continuous (fun x : P => x * g.2) := continuous_of_discreteTopology
  exact (ha.comp continuous_fst).prodMk (hp.comp continuous_snd)

private theorem model_inverse_continuous : Continuous (fun x : M => x⁻¹) := by
  have ha : Continuous (fun x : A => x⁻¹) :=
    continuous_ofAdd.comp
      ((cofinite_integer_injection_continuous (fun n => -n) neg_injective).comp
        continuous_toAdd)
  have hp : Continuous (fun x : P => x⁻¹) := continuous_of_discreteTopology
  exact (ha.comp continuous_fst).prodMk (hp.comp continuous_snd)

private theorem cofinite_integers_not_t2 : ¬ T2Space ℤ := by
  intro h
  let : T2Space ℤ := h
  let : IrreducibleSpace ℤ := Function.Surjective.irreducibleSpace
    (WithTopology.continuous_ofTopology (X := ℤ) (t := TopologicalSpace.cofinite))
    (WithTopology.ofTopology_surjective TopologicalSpace.cofinite)
  exact not_preirreducible_nontrivial_t2 ℤ

private theorem model_not_t2 : ¬ T2Space M := by
  intro h
  let : T2Space M := h
  let i : ℤ → M := fun n => (Multiplicative.ofAdd n, 1)
  have hi : Continuous i := continuous_ofAdd.prodMk continuous_const
  have hinj : Function.Injective i := by
    intro x y hxy
    exact congrArg (fun z : M => z.1.toAdd) hxy
  exact cofinite_integers_not_t2 (T2Space.of_injective_continuous hinj hi)

private theorem cofinite_sum_hits (U V : Set ℤ) (hU : IsOpen U) (hV : IsOpen V)
    (hUne : U.Nonempty) (hVne : V.Nonempty) (t : ℤ) :
    ∃ u ∈ U, ∃ v ∈ V, u + v = t := by
  classical
  change U.Nonempty → Uᶜ.Finite at hU
  change V.Nonempty → Vᶜ.Finite at hV
  have hinj : Function.Injective (fun x : ℤ => t - x) := by
    intro x y hxy
    exact neg_injective (add_left_cancel (show t + -x = t + -y from hxy))
  have hfinite : (Uᶜ ∪ (fun x : ℤ => t - x) ⁻¹' Vᶜ).Finite :=
    (hU hUne).union (Set.Finite.preimage hinj.injOn (hV hVne))
  obtain ⟨u, hu⟩ := hfinite.exists_notMem
  refine ⟨u, ?_, t - u, ?_, ?_⟩
  · by_contra h
    exact hu (Or.inl h)
  · by_contra h
    exact hu (Or.inr h)
  · simp [sub_eq_add_neg, add_left_comm]

private theorem cofinite_add_not_continuous :
    ¬ Continuous (fun x : ℤ × ℤ => x.1 + x.2) := by
  intro h
  have hopen : IsOpen ({1}ᶜ : Set ℤ) := by
    change ({1}ᶜ : Set ℤ).Nonempty → ({1}ᶜ : Set ℤ)ᶜ.Finite
    intro _
    simpa only [compl_compl] using Set.finite_singleton (1 : ℤ)
  have hnhds : (fun x : ℤ × ℤ => x.1 + x.2) ⁻¹' {1}ᶜ ∈ 𝓝 ((0 : ℤ), (0 : ℤ)) :=
    h.continuousAt.preimage_mem_nhds (hopen.mem_nhds (by norm_num))
  obtain ⟨U, V, hU, h0U, hV, h0V, hUV⟩ := mem_nhds_prod_iff'.mp hnhds
  obtain ⟨u, hu, v, hv, huv⟩ := cofinite_sum_hits U V hU hV ⟨0, h0U⟩ ⟨0, h0V⟩ 1
  have hpair : ((u, v) : ℤ × ℤ) ∈ U ×ˢ V := Set.mk_mem_prod hu hv
  have hsum : (fun x : ℤ × ℤ => x.1 + x.2) (u, v) ∈ ({1} : Set ℤ) :=
    Set.mem_singleton_iff.mpr huv
  exact (hUV hpair) hsum

private theorem model_mul_not_continuous :
    ¬ Continuous (fun x : M × M => x.1 * x.2) := by
  intro h
  let i : ℤ → M := fun n => (Multiplicative.ofAdd n, 1)
  have hi : Continuous i := continuous_ofAdd.prodMk continuous_const
  have hp : Continuous (fun x : ℤ × ℤ => (i x.1, i x.2)) :=
    (hi.comp continuous_fst).prodMk (hi.comp continuous_snd)
  exact cofinite_add_not_continuous
    (continuous_toAdd.comp (continuous_fst.comp (h.comp hp)))

private theorem tau_order : orderOf tau = 2 := by
  let : Fact (Nat.Prime 2) := ⟨by decide⟩
  exact orderOf_eq_prime (by simp [tau, pow_two]) (by decide)

private theorem mem_K (p : P) : p ∈ K ↔ p = 1 ∨ p = tau := by
  change p ∈ Subgroup.zpowers tau ↔ p = 1 ∨ p = tau
  rw [mem_zpowers_iff_mem_range_orderOf, tau_order]
  change p ∈ (Finset.range (1 + 1)).image (tau ^ ·) ↔ p = 1 ∨ p = tau
  rw [Finset.range_add_one, Finset.range_one]
  simp only [Finset.image_insert, Finset.image_singleton, pow_one, pow_zero,
    Finset.mem_insert, Finset.mem_singleton, or_comm]

private theorem K_fixes_two {p : P} (hp : p ∈ K) : p (2 : Fin 3) = 2 := by
  rcases (mem_K p).mp hp with rfl | rfl
  · rfl
  · decide

private theorem sigma_not_mem_K : sigma ∉ K := by
  intro h
  have hfix := K_fixes_two h
  exact (by decide : sigma (2 : Fin 3) ≠ 2) hfix

private theorem model_subgroup_open : IsOpen (H : Set M) := by
  have heq : (H : Set M) = Prod.snd ⁻¹' (K : Set P) := by
    ext x
    simp [H, Subgroup.mem_prod]
  rw [heq]
  exact (isOpen_discrete (K : Set P)).preimage continuous_snd

private theorem model_subgroup_proper : H ≠ ⊤ := by
  intro h
  have hmem : ((1 : A), sigma) ∈ H := by
    rw [h]
    exact Subgroup.mem_top _
  exact sigma_not_mem_K (by simpa [H, Subgroup.mem_prod] using hmem)

private theorem model_subgroup_not_normal : ¬ H.Normal := by
  intro h
  have htau : ((1 : A), tau) ∈ H := by simp [H, K, Subgroup.mem_prod]
  have hconj := h.conj_mem ((1 : A), tau) htau ((1 : A), sigma)
  have hK : sigma * tau * sigma⁻¹ ∈ K := by
    simpa [H, Subgroup.mem_prod] using hconj
  have hfix := K_fixes_two hK
  exact (by decide : (sigma * tau * sigma⁻¹) (2 : Fin 3) ≠ 2) hfix

private theorem model_subgroup_index : H.index = 3 := by
  classical
  have hP : Nat.card P = 6 := by
    rw [Nat.card_eq_fintype_card, Fintype.card_perm]
    norm_num [Nat.factorial_succ]
  have hK : Nat.card K = 2 := by
    rw [Nat.card_eq_fintype_card, Fintype.card_zpowers, tau_order]
  change ((⊤ : Subgroup A).prod K).index = 3
  rw [Subgroup.index_prod, Subgroup.index_top, one_mul, Subgroup.index_eq_card_div, hP, hK]

-- None of the boundary premises in this conjunction use the library statements.
private theorem model_boundaries :
    CompactSpace M ∧ Infinite M ∧ ContinuousConstSMul M M ∧ ¬ T2Space M ∧
      ¬ Continuous (fun x : M × M => x.1 * x.2) ∧
      IsOpen (H : Set M) ∧ H ≠ ⊤ ∧ ¬ H.Normal ∧ H.index = 3 := by
  exact ⟨model_compact, model_infinite, inferInstance, model_not_t2, model_mul_not_continuous,
    model_subgroup_open, model_subgroup_proper, model_subgroup_not_normal,
    model_subgroup_index⟩

-- The quotient really has three classes even before either headline is used.
private theorem model_coset_card : Nat.card (M ⧸ H) = 3 := model_subgroup_index

private theorem model_distinct_cosets :
    (QuotientGroup.mk ((1 : A), (1 : P)) : M ⧸ H) ≠
      QuotientGroup.mk ((1 : A), sigma) := by
  intro heq
  exact sigma_not_mem_K (by simpa [H, Subgroup.mem_prod] using QuotientGroup.eq.mp heq)

private theorem model_fiber_at_swap :
    ((1 : A), sigma) ∈
      (QuotientGroup.mk : M → M ⧸ H) ⁻¹' {QuotientGroup.mk ((1 : A), sigma)} ∧
    ((1 : A), (1 : P)) ∉
      (QuotientGroup.mk : M → M ⧸ H) ⁻¹' {QuotientGroup.mk ((1 : A), sigma)} := by
  constructor
  · exact Set.mem_singleton _
  · exact model_distinct_cosets

private theorem model_headline_clients : DiscreteTopology (M ⧸ H) ∧ Finite (M ⧸ H) := by
  exact ⟨(H.isOpen_iff_discreteTopology_quotient).mp model_subgroup_open,
    H.finiteIndex_iff_finite_quotient.mp (H.finiteIndex_of_isOpen model_subgroup_open)⟩

end CofiniteProduct

section PrimitiveOption

local instance : TopologicalSpace ℤ := TopologicalSpace.cofinite

-- Both primitive scalar operators are nonidentity shifts; no action laws are installed.
private def bool_shift (b : Bool) : A :=
  Multiplicative.ofAdd (if b then (2 : ℤ) else 1)

local instance : SMul Bool A := ⟨fun b x => bool_shift b * x⟩

private theorem bool_smul_def (b : Bool) (x : A) : b • x = bool_shift b * x := by
  rfl

private theorem bool_shift_continuous (b : Bool) : Continuous (fun x : A => b • x) := by
  exact continuous_ofAdd.comp
    ((cofinite_integer_injection_continuous (fun n => (bool_shift b).toAdd + n)
      (fun _ _ h => add_left_cancel h)).comp continuous_toAdd)

local instance : ContinuousConstSMul Bool A where
  continuous_const_smul := bool_shift_continuous

private theorem cofinite_identity_not_open : ¬ IsOpen ({1} : Set A) := by
  intro h
  have hz : IsOpen ({0} : Set ℤ) := by
    have heq : (Multiplicative.ofAdd : ℤ → A) ⁻¹' {1} = {0} := by
      ext x
      simp only [Set.mem_preimage, Set.mem_singleton_iff, ofAdd_eq_one]
    rw [← heq]
    exact h.preimage continuous_ofAdd
  change ({0} : Set ℤ).Nonempty → ({0} : Set ℤ)ᶜ.Finite at hz
  exact (Set.finite_singleton (0 : ℤ)).infinite_compl (hz ⟨0, rfl⟩)

private theorem cofinite_action_source_not_discrete : ¬ DiscreteTopology A := by
  intro h
  let : DiscreteTopology A := h
  exact cofinite_identity_not_open (isOpen_discrete _)

private theorem bool_moves_identity (b : Bool) : b • (1 : A) ≠ 1 := by
  cases b
  · change Multiplicative.ofAdd (1 : ℤ) * 1 ≠ 1
    rw [mul_one]
    exact fun h => (by norm_num : (1 : ℤ) ≠ 0) (ofAdd_eq_one.mp h)
  · change Multiplicative.ofAdd (2 : ℤ) * 1 ≠ 1
    rw [mul_one]
    exact fun h => (by norm_num : (2 : ℤ) ≠ 0) (ofAdd_eq_one.mp h)

private theorem bool_operators_distinct :
    (fun x : A => false • x) ≠ (fun x : A => true • x) := by
  intro h
  have heq := congrFun h (1 : A)
  change Multiplicative.ofAdd (1 : ℤ) * 1 = Multiplicative.ofAdd (2 : ℤ) * 1 at heq
  simp only [mul_one] at heq
  have hz := Multiplicative.ofAdd.injective heq
  norm_num at hz

private theorem bool_has_no_identity_operator (e : Bool) : ¬ ∀ x : A, e • x = x := by
  intro h
  exact bool_moves_identity e (h 1)

private theorem primitive_source_inhabited : Nonempty A ∧ Nontrivial A := by
  exact ⟨inferInstance, inferInstance⟩

-- Some is bundled through the existing primitive equivariant-map constructor.
private def some_equivariant : A →[Bool] Option A where
  toFun := Option.some
  map_smul' b x := (Option.smul_some b x).symm

private theorem some_equivariant_apply (x : A) : some_equivariant x = some x := by
  rfl

local instance : TopologicalSpace (Option A) :=
  TopologicalSpace.coinduced (@Option.some A) inferInstance

private theorem some_coinducing : Topology.IsCoinducing (@Option.some A) := by
  exact ⟨rfl⟩

private theorem some_hom_coinducing :
    Topology.IsCoinducing (some_equivariant : A → Option A) := by
  exact some_coinducing

private theorem none_has_no_preimage : ¬ ∃ x : A, some_equivariant x = none := by
  rintro ⟨x, hx⟩
  change some x = none at hx
  cases hx

private theorem some_not_surjective : ¬ Function.Surjective (some_equivariant : A → Option A) := by
  intro h
  exact none_has_no_preimage (h none)

private theorem some_open_embedding : Topology.IsOpenEmbedding (@Option.some A) := by
  exact Topology.IsOpenEmbedding.of_continuous_injective_isOpenMap
    some_coinducing.continuous (Option.some_injective A)
    (some_coinducing.isOpenMap_of_injective (Option.some_injective A))

private theorem some_retains_source_topology :
    (inferInstance : TopologicalSpace A) =
      TopologicalSpace.induced (@Option.some A) (inferInstance : TopologicalSpace (Option A)) := by
  exact some_open_embedding.isInducing.eq_induced

-- This boundary uses only the inclusion, not transported target-action continuity.
private theorem coinduced_option_not_discrete : ¬ DiscreteTopology (Option A) := by
  intro h
  let : DiscreteTopology (Option A) := h
  exact cofinite_action_source_not_discrete
    (DiscreteTopology.of_continuous_injective some_coinducing.continuous
      (Option.some_injective A))

private theorem primitive_option_boundaries :
    Nonempty A ∧ Nontrivial A ∧ ¬ DiscreteTopology A ∧
      ContinuousConstSMul Bool A ∧ ¬ DiscreteTopology (Option A) ∧
      ¬ Function.Surjective (some_equivariant : A → Option A) ∧
      (∀ b : Bool, b • (1 : A) ≠ 1) ∧
      (fun x : A => false • x) ≠ (fun x : A => true • x) := by
  exact ⟨primitive_source_inhabited.1, primitive_source_inhabited.2,
    cofinite_action_source_not_discrete, inferInstance, coinduced_option_not_discrete,
    some_not_surjective, bool_moves_identity, bool_operators_distinct⟩

-- Target continuity is obtained only after the independent input/boundary proofs.
private theorem primitive_option_fixed_action (b : Bool) :
    Continuous (fun x : Option A => b • x) := by
  let : ContinuousConstSMul Bool (Option A) :=
    Topology.IsCoinducing.continuousConstSMul some_equivariant some_hom_coinducing
  exact continuous_const_smul b

private theorem primitive_option_characteristic (b : Bool) :
    b • (none : Option A) = none ∧
      b • some (1 : A) = some (b • (1 : A)) ∧
      b • some (1 : A) ≠ some (1 : A) := by
  refine ⟨Option.smul_none b, Option.smul_some b 1, ?_⟩
  rw [Option.smul_some]
  exact fun h => bool_moves_identity b ((Option.some_injective A) h)

end PrimitiveOption

section PartitionProduct

-- The target topology in this construction is explicitly bottom (discrete),
-- never the canonical coinduced quotient instance that depends on the source.
local instance : TopologicalSpace ℤ := TopologicalSpace.cofinite
local instance : TopologicalSpace P :=
  TopologicalSpace.induced (QuotientGroup.mk : P → P ⧸ K) (⊥ : TopologicalSpace (P ⧸ K))

local instance : CompactSpace ℤ :=
  Function.Surjective.compactSpace
    (WithTopology.continuous_ofTopology (X := ℤ) (t := TopologicalSpace.cofinite))
    (WithTopology.ofTopology_surjective TopologicalSpace.cofinite)

private theorem partition_left_translation_continuous (g : P) :
    Continuous (fun x : P => g * x) := by
  let : TopologicalSpace (P ⧸ K) := ⊥
  let : DiscreteTopology (P ⧸ K) := discreteTopology_bot (P ⧸ K)
  apply (continuous_induced_rng (f := (QuotientGroup.mk : P → P ⧸ K))).mpr
  have hg : Continuous (fun q : P ⧸ K => g • q) := continuous_of_discreteTopology
  simpa only [Function.comp_def, MulAction.Quotient.smul_mk, smul_eq_mul] using
    hg.comp (continuous_induced_dom (f := (QuotientGroup.mk : P → P ⧸ K)))

local instance : ContinuousConstSMul P P where
  continuous_const_smul g := partition_left_translation_continuous g

private theorem partition_inseparable_iff_coset_eq (x y : P) :
    Inseparable x y ↔ (QuotientGroup.mk x : P ⧸ K) = QuotientGroup.mk y := by
  let : TopologicalSpace (P ⧸ K) := ⊥
  let : DiscreteTopology (P ⧸ K) := discreteTopology_bot (P ⧸ K)
  exact (Topology.IsInducing.induced (QuotientGroup.mk : P → P ⧸ K)).inseparable_iff.symm.trans
    inseparable_iff_eq

private theorem partition_one_tau_inseparable : Inseparable (1 : P) tau := by
  apply (partition_inseparable_iff_coset_eq 1 tau).mpr
  apply QuotientGroup.eq.mpr
  simp [K]

private theorem partition_sigma_sigma_tau_inseparable : Inseparable sigma (sigma * tau) := by
  apply (partition_inseparable_iff_coset_eq sigma (sigma * tau)).mpr
  apply QuotientGroup.eq.mpr
  simp [K]

private theorem partition_right_image_cosets_distinct :
    (QuotientGroup.mk sigma : P ⧸ K) ≠ QuotientGroup.mk (tau * sigma) := by
  intro h
  have hfix := K_fixes_two (QuotientGroup.eq.mp h)
  exact (by decide : (sigma⁻¹ * (tau * sigma)) (2 : Fin 3) ≠ 2) hfix

private theorem partition_right_not_continuous :
    ¬ Continuous (fun x : P => x * sigma) := by
  intro h
  have hi := partition_one_tau_inseparable.map h
  apply partition_right_image_cosets_distinct
  exact (partition_inseparable_iff_coset_eq sigma (tau * sigma)).mp (by simpa using hi)

private theorem partition_inverse_not_continuous :
    ¬ Continuous (fun x : P => x⁻¹) := by
  intro h
  have hi := partition_sigma_sigma_tau_inseparable.map h
  have heq := (partition_inseparable_iff_coset_eq sigma⁻¹ ((sigma * tau)⁻¹)).mp hi
  apply partition_right_image_cosets_distinct
  simpa only [mul_inv_rev, sigma, tau, Equiv.swap_inv] using heq

private theorem partition_mul_not_continuous :
    ¬ Continuous (fun x : P × P => x.1 * x.2) := by
  intro h
  exact partition_right_not_continuous (h.comp (continuous_id.prodMk continuous_const))

private theorem partition_no_right_action : ¬ ContinuousConstSMul Pᵐᵒᵖ P := by
  intro h
  let : ContinuousConstSMul Pᵐᵒᵖ P := h
  exact partition_right_not_continuous (continuous_const_smul (MulOpposite.op sigma))

private theorem partition_not_separately_continuous : ¬ SeparatelyContinuousMul P := by
  intro h
  exact partition_right_not_continuous (h.continuous_mul_const (a := sigma))

private theorem partition_no_continuous_inv : ¬ ContinuousInv P := by
  intro h
  exact partition_inverse_not_continuous h.continuous_inv

private theorem partition_not_t0 : ¬ T0Space P := by
  intro h
  let : T0Space P := h
  exact (by decide : (1 : P) ≠ tau) partition_one_tau_inseparable.eq

private theorem partition_open_K : IsOpen (K : Set P) := by
  let : TopologicalSpace (P ⧸ K) := ⊥
  let : DiscreteTopology (P ⧸ K) := discreteTopology_bot (P ⧸ K)
  rw [← QuotientGroup.preimage_mk_one]
  exact (isOpen_discrete {(QuotientGroup.mk : P → P ⧸ K) 1}).preimage
    (continuous_induced_dom (f := (QuotientGroup.mk : P → P ⧸ K)))

-- Closedness is a premise established from the auxiliary input topology alone.
private theorem partition_closed_K : IsClosed (K : Set P) := by
  let : TopologicalSpace (P ⧸ K) := ⊥
  let : DiscreteTopology (P ⧸ K) := discreteTopology_bot (P ⧸ K)
  rw [← QuotientGroup.preimage_mk_one]
  exact (isClosed_singleton (x := (QuotientGroup.mk : P → P ⧸ K) 1)).preimage
    (continuous_induced_dom (f := (QuotientGroup.mk : P → P ⧸ K)))

private theorem partition_K_proper : K ≠ ⊤ := by
  intro h
  apply sigma_not_mem_K
  rw [h]
  exact Subgroup.mem_top _

private theorem partition_K_not_normal : ¬ K.Normal := by
  intro h
  have hfix := K_fixes_two (h.conj_mem tau (Subgroup.mem_zpowers tau) sigma)
  exact (by decide : (sigma * tau * sigma⁻¹) (2 : Fin 3) ≠ 2) hfix

private theorem partition_K_index : K.index = 3 := by
  simpa only [H, Subgroup.index_prod, Subgroup.index_top, one_mul] using model_subgroup_index

private theorem partition_K_finiteIndex : K.FiniteIndex := by
  refine ⟨?_⟩
  rw [partition_K_index]
  decide

private theorem partition_closed_index_clients :
    T1Space (P ⧸ K) ∧ IsOpen (K : Set P) ∧ IsClopen (K : Set P) := by
  let : K.FiniteIndex := partition_K_finiteIndex
  exact ⟨(K.isClosed_iff_t1Space_quotient).mp partition_closed_K,
    (K.isOpen_iff_isClosed).mpr partition_closed_K,
    (K.isClopen_iff_isClosed).mpr partition_closed_K⟩

-- This is a property of the canonical coinduced quotient AFTER the source
-- partition topology is fixed. The auxiliary target is used only in the proof.
private theorem partition_canonical_quotient_discrete : DiscreteTopology (P ⧸ K) := by
  apply discreteTopology_iff_forall_isOpen.mpr
  intro U
  apply (QuotientGroup.isQuotientMap_mk K).isCoinducing.isOpen_preimage.mp
  let : TopologicalSpace (P ⧸ K) := ⊥
  let : DiscreteTopology (P ⧸ K) := discreteTopology_bot (P ⧸ K)
  exact (isOpen_discrete U).preimage
    (continuous_induced_dom (f := (QuotientGroup.mk : P → P ⧸ K)))

-- No separately continuous or right-action instance is a premise of these calls.
private theorem partition_headline_clients : DiscreteTopology (P ⧸ K) ∧ K.FiniteIndex := by
  exact ⟨(K.isOpen_iff_discreteTopology_quotient).mp partition_open_K,
    K.finiteIndex_of_isOpen partition_open_K⟩

private theorem partition_product_left_translation_continuous (g : M) :
    Continuous (fun x : M => g * x) := by
  have ha : Continuous (fun x : A => g.1 * x) :=
    continuous_ofAdd.comp
      ((cofinite_integer_injection_continuous (fun n => g.1.toAdd + n)
        (fun _ _ h => add_left_cancel h)).comp continuous_toAdd)
  have hp := partition_left_translation_continuous g.2
  exact (ha.comp continuous_fst).prodMk (hp.comp continuous_snd)

local instance : ContinuousConstSMul M M where
  continuous_const_smul g := partition_product_left_translation_continuous g

private theorem partition_product_compact : CompactSpace M := inferInstance

private theorem partition_product_infinite : Infinite M := model_infinite

private theorem partition_product_right_not_continuous :
    ¬ Continuous (fun x : M => x * ((1 : A), sigma)) := by
  intro h
  have hi : Continuous (fun x : P => ((1 : A), x)) := continuous_const.prodMk continuous_id
  exact partition_right_not_continuous (continuous_snd.comp (h.comp hi))

private theorem partition_product_inverse_not_continuous :
    ¬ Continuous (fun x : M => x⁻¹) := by
  intro h
  have hi : Continuous (fun x : P => ((1 : A), x)) := continuous_const.prodMk continuous_id
  exact partition_inverse_not_continuous (continuous_snd.comp (h.comp hi))

private theorem partition_product_mul_not_continuous :
    ¬ Continuous (fun x : M × M => x.1 * x.2) := by
  intro h
  exact partition_product_right_not_continuous
    (h.comp (continuous_id.prodMk continuous_const))

private theorem partition_product_no_right_action : ¬ ContinuousConstSMul Mᵐᵒᵖ M := by
  intro h
  let : ContinuousConstSMul Mᵐᵒᵖ M := h
  exact partition_product_right_not_continuous
    (continuous_const_smul (MulOpposite.op ((1 : A), sigma)))

private theorem partition_product_not_separately_continuous : ¬ SeparatelyContinuousMul M := by
  intro h
  exact partition_product_right_not_continuous (h.continuous_mul_const (a := ((1 : A), sigma)))

private theorem partition_product_no_continuous_inv : ¬ ContinuousInv M := by
  intro h
  exact partition_product_inverse_not_continuous h.continuous_inv

private theorem partition_product_not_t0 : ¬ T0Space M := by
  intro h
  let : T0Space M := h
  have hi := (Inseparable.refl (1 : A)).prod partition_one_tau_inseparable
  have heq : (1 : P) = tau := congrArg Prod.snd hi.eq
  exact (by decide : (1 : P) ≠ tau) heq

private theorem partition_product_not_t1 : ¬ T1Space M := by
  intro h
  let : T1Space M := h
  exact partition_product_not_t0 inferInstance

private theorem partition_product_not_t2 : ¬ T2Space M := by
  intro h
  let : T2Space M := h
  exact partition_product_not_t0 inferInstance

private theorem partition_product_subgroup_open : IsOpen (H : Set M) := by
  have heq : (H : Set M) = Prod.snd ⁻¹' (K : Set P) := by
    ext x
    simp [H, Subgroup.mem_prod]
  rw [heq]
  exact partition_open_K.preimage continuous_snd

private theorem partition_product_subgroup_closed : IsClosed (H : Set M) := by
  have heq : (H : Set M) = Prod.snd ⁻¹' (K : Set P) := by
    ext x
    simp [H, Subgroup.mem_prod]
  rw [heq]
  exact partition_closed_K.preimage continuous_snd

private theorem partition_product_subgroup_finiteIndex : H.FiniteIndex := by
  refine ⟨?_⟩
  rw [model_subgroup_index]
  decide

private theorem partition_product_closed_index_clients :
    T1Space (M ⧸ H) ∧ IsOpen (H : Set M) ∧ IsClopen (H : Set M) := by
  let : H.FiniteIndex := partition_product_subgroup_finiteIndex
  exact ⟨(H.isClosed_iff_t1Space_quotient).mp partition_product_subgroup_closed,
    (H.isOpen_iff_isClosed).mpr partition_product_subgroup_closed,
    (H.isClopen_iff_isClosed).mpr partition_product_subgroup_closed⟩

private theorem partition_product_subgroup_nontrivial : ∃ h : H, (h : M) ≠ 1 := by
  refine ⟨⟨((1 : A), tau), by simp [H, K, Subgroup.mem_prod]⟩, ?_⟩
  intro h
  exact (by decide : tau ≠ (1 : P)) (congrArg Prod.snd h)

private theorem partition_product_subgroup_infinite : Infinite H := by
  let i : A → H := fun x => ⟨(x, 1), by simp [H, Subgroup.mem_prod]⟩
  have hi : Function.Injective i := by
    intro x y h
    exact congrArg (fun z : H => (z : M).1) h
  exact Infinite.of_injective i hi

private theorem partition_product_boundaries :
    CompactSpace M ∧ Infinite M ∧ ContinuousConstSMul M M ∧
      ¬ ContinuousConstSMul Mᵐᵒᵖ M ∧ ¬ SeparatelyContinuousMul M ∧
      ¬ Continuous (fun x : M × M => x.1 * x.2) ∧
      ¬ Continuous (fun x : M => x⁻¹) ∧ ¬ T0Space M ∧ ¬ T1Space M ∧ ¬ T2Space M ∧
      IsOpen (H : Set M) ∧ H ≠ ⊤ ∧ ¬ H.Normal ∧ H.index = 3 ∧ Infinite H := by
  exact ⟨partition_product_compact, partition_product_infinite, inferInstance,
    partition_product_no_right_action, partition_product_not_separately_continuous,
    partition_product_mul_not_continuous, partition_product_inverse_not_continuous,
    partition_product_not_t0, partition_product_not_t1, partition_product_not_t2,
    partition_product_subgroup_open, model_subgroup_proper, model_subgroup_not_normal,
    model_subgroup_index, partition_product_subgroup_infinite⟩

private theorem partition_product_headline_clients :
    DiscreteTopology (M ⧸ H) ∧ Finite (M ⧸ H) := by
  exact ⟨(H.isOpen_iff_discreteTopology_quotient).mp partition_product_subgroup_open,
    H.finiteIndex_iff_finite_quotient.mp
      (H.finiteIndex_of_isOpen partition_product_subgroup_open)⟩

-- The old nonnormal controls keep their canonical, discrete quotient outputs.
private theorem partition_quotient_action_clients :
    Continuous (fun q : P ⧸ K => sigma • q) ∧
      Continuous (fun q : P ⧸ K => tau • q) ∧
      sigma • (QuotientGroup.mk (1 : P) : P ⧸ K) ≠ QuotientGroup.mk 1 ∧
      tau • (QuotientGroup.mk (1 : P) : P ⧸ K) = QuotientGroup.mk 1 ∧
      MulAction.stabilizer P (QuotientGroup.mk (1 : P) : P ⧸ K) = K := by
  refine ⟨continuous_const_smul sigma, continuous_const_smul tau, ?_, ?_,
    MulAction.stabilizer_quotient K⟩
  · simp only [MulAction.Quotient.smul_mk, smul_eq_mul, mul_one]
    intro h
    exact sigma_not_mem_K (by simpa using (QuotientGroup.eq.mp h.symm))
  · simp only [MulAction.Quotient.smul_mk, smul_eq_mul, mul_one]
    apply QuotientGroup.eq.mpr
    simpa only [mul_one] using K.inv_mem (Subgroup.mem_zpowers tau)

private theorem partition_product_quotient_action_clients :
    Continuous (fun q : M ⧸ H => ((1 : A), sigma) • q) ∧
      Continuous (fun q : M ⧸ H => ((1 : A), tau) • q) ∧
      ((1 : A), sigma) • (QuotientGroup.mk (1 : M) : M ⧸ H) ≠ QuotientGroup.mk 1 ∧
      ((1 : A), tau) • (QuotientGroup.mk (1 : M) : M ⧸ H) = QuotientGroup.mk 1 := by
  refine ⟨continuous_const_smul _, continuous_const_smul _, ?_, ?_⟩
  · simp only [MulAction.Quotient.smul_mk, smul_eq_mul, mul_one]
    change (QuotientGroup.mk ((1 : A), sigma) : M ⧸ H) ≠
      QuotientGroup.mk ((1 : A), (1 : P))
    exact model_distinct_cosets.symm
  · simp only [MulAction.Quotient.smul_mk, smul_eq_mul, mul_one]
    apply QuotientGroup.eq.mpr
    simp [H, K, Subgroup.mem_prod]

-- Bottom is a normal, nondiscrete control on precisely the same strict source P.
private theorem bottom_projection_injective :
    Function.Injective (QuotientGroup.mk : P → P ⧸ (⊥ : Subgroup P)) := by
  intro x y h
  exact eq_of_inv_mul_eq_one (Subgroup.mem_bot.mp (QuotientGroup.eq.mp h))

-- The identity inclusion retains distinct classes, whereas bottom → K merges 1 and tau.
private theorem nested_coset_identity_distinguishes_sigma :
    MulActionHom.quotientMapOfLE (le_refl K) (QuotientGroup.mk (1 : P)) ≠
      MulActionHom.quotientMapOfLE (le_refl K) (QuotientGroup.mk sigma) := by
  simp only [MulActionHom.quotientMapOfLE_refl, MulActionHom.id_apply]
  intro h
  exact sigma_not_mem_K (by simpa only [inv_one, one_mul] using QuotientGroup.eq.mp h)

private theorem nested_coset_collision :
    (QuotientGroup.mk (1 : P) : P ⧸ (⊥ : Subgroup P)) ≠ QuotientGroup.mk tau ∧
      MulActionHom.quotientMapOfLE (bot_le : (⊥ : Subgroup P) ≤ K)
          (QuotientGroup.mk (1 : P)) =
        MulActionHom.quotientMapOfLE (bot_le : (⊥ : Subgroup P) ≤ K)
          (QuotientGroup.mk tau) ∧
      MulActionHom.quotientMapOfLE (bot_le : (⊥ : Subgroup P) ≤ K)
          (QuotientGroup.mk (1 : P)) ≠
        MulActionHom.quotientMapOfLE (bot_le : (⊥ : Subgroup P) ≤ K)
          (QuotientGroup.mk sigma) := by
  refine ⟨?_, ?_, ?_⟩
  · intro h
    exact (by decide : (1 : P) ≠ tau) (bottom_projection_injective h)
  · rw [MulActionHom.quotientMapOfLE_apply_mk, MulActionHom.quotientMapOfLE_apply_mk]
    apply QuotientGroup.eq.mpr
    simpa only [inv_one, one_mul] using Subgroup.mem_zpowers tau
  · simpa only [MulActionHom.quotientMapOfLE_apply_mk,
      MulActionHom.quotientMapOfLE_refl, MulActionHom.id_apply] using
      nested_coset_identity_distinguishes_sigma

private theorem partition_bottom_not_t1 : ¬ T1Space (P ⧸ (⊥ : Subgroup P)) := by
  intro h
  let : T1Space (P ⧸ (⊥ : Subgroup P)) := h
  let : T1Space P := t1Space_of_injective_of_continuous bottom_projection_injective
    QuotientGroup.continuous_mk
  exact partition_not_t0 inferInstance

private theorem partition_bottom_not_discrete :
    ¬ DiscreteTopology (P ⧸ (⊥ : Subgroup P)) := by
  intro h
  let : DiscreteTopology (P ⧸ (⊥ : Subgroup P)) := h
  let : DiscreteTopology P := DiscreteTopology.of_continuous_injective
    QuotientGroup.continuous_mk bottom_projection_injective
  exact partition_not_t0 inferInstance

private theorem partition_bottom_boundaries :
    (⊥ : Subgroup P).Normal ∧ ¬ T1Space (P ⧸ (⊥ : Subgroup P)) ∧
      ¬ DiscreteTopology (P ⧸ (⊥ : Subgroup P)) := by
  exact ⟨inferInstance, partition_bottom_not_t1, partition_bottom_not_discrete⟩

private theorem partition_bottom_action_clients (g : P) :
    Continuous (fun q : P ⧸ (⊥ : Subgroup P) => g • q) ∧
      Function.Semiconj (QuotientGroup.mk : P → P ⧸ (⊥ : Subgroup P))
        (fun x : P => g * x) (fun q : P ⧸ (⊥ : Subgroup P) => g • q) ∧
      sigma • (QuotientGroup.mk (1 : P) : P ⧸ (⊥ : Subgroup P)) ≠ QuotientGroup.mk 1 := by
  refine ⟨continuous_const_smul g, projection_semiconj _ g, ?_⟩
  intro h
  have hs : sigma = (1 : P) := bottom_projection_injective
    (by simpa only [MulAction.Quotient.smul_mk, smul_eq_mul, mul_one] using h)
  exact (by decide : sigma ≠ (1 : P)) hs

private abbrev J : Subgroup M := (⊥ : Subgroup A).prod K

-- This lift records the first coordinate, not a product-quotient homeomorphism.
private theorem first_coordinate_compatible (x y : M) (h : QuotientGroup.leftRel J x y) :
    x.1 = y.1 := by
  have hm := (Subgroup.mem_prod.mp (QuotientGroup.leftRel_apply.mp h)).1
  exact eq_of_inv_mul_eq_one (Subgroup.mem_bot.mp hm)

private def first_coordinate (q : M ⧸ J) : A :=
  Quotient.liftOn' q Prod.fst first_coordinate_compatible

private theorem first_coordinate_mk (x : M) :
    first_coordinate (QuotientGroup.mk x) = x.1 := by
  exact QuotientGroup.quotient_liftOn_mk Prod.fst first_coordinate_compatible x

private theorem first_coordinate_comp_mk :
    first_coordinate ∘ (QuotientGroup.mk : M → M ⧸ J) = Prod.fst := by
  funext x
  exact first_coordinate_mk x

private theorem first_coordinate_quotient_map : Topology.IsQuotientMap first_coordinate := by
  apply (QuotientGroup.isQuotientMap_mk J).of_comp_isQuotientMap
  rw [first_coordinate_comp_mk]
  exact isQuotientMap_fst

private theorem first_coordinate_continuous : Continuous first_coordinate := by
  exact first_coordinate_quotient_map.continuous

private theorem first_coordinate_surjective : Function.Surjective first_coordinate := by
  exact first_coordinate_quotient_map.surjective

private theorem J_quotient_infinite : Infinite (M ⧸ J) := by
  exact Infinite.of_surjective first_coordinate first_coordinate_surjective

private theorem J_index_zero : J.index = 0 := by
  exact Subgroup.index_eq_zero_iff_infinite.mpr J_quotient_infinite

private theorem J_not_finiteIndex : ¬ J.FiniteIndex := by
  exact Subgroup.not_finiteIndex_iff.mpr J_index_zero

-- Discreteness is ruled out by the quotient observer before fixed-action descent.
private theorem J_quotient_not_discrete : ¬ DiscreteTopology (M ⧸ J) := by
  intro h
  let : DiscreteTopology (M ⧸ J) := h
  apply cofinite_identity_not_open
  apply first_coordinate_quotient_map.isCoinducing.isOpen_preimage.mp
  exact isOpen_discrete _

private theorem J_not_open : ¬ IsOpen (J : Set M) := by
  intro h
  have hi : Continuous (fun a : A => (a, (1 : P))) :=
    continuous_id.prodMk continuous_const
  have heq : (fun a : A => (a, (1 : P))) ⁻¹' (J : Set M) = {1} := by
    ext a
    simp [J, Subgroup.mem_prod]
  exact cofinite_identity_not_open (heq ▸ h.preimage hi)

private theorem J_comap_inr : J.comap (MonoidHom.inr A P) = K := by
  ext p
  simp [J, Subgroup.mem_prod]

private theorem J_not_normal : ¬ J.Normal := by
  intro h
  have hK := h.comap (MonoidHom.inr A P)
  rw [J_comap_inr] at hK
  exact partition_K_not_normal hK

private theorem J_finite : Finite J := by
  let f : J → P := fun x => (x : M).2
  apply Finite.of_injective f
  intro x y h
  apply Subtype.ext
  apply Prod.ext
  · have hx : (x : M).1 = 1 := Subgroup.mem_bot.mp (Subgroup.mem_prod.mp x.property).1
    have hy : (y : M).1 = 1 := Subgroup.mem_bot.mp (Subgroup.mem_prod.mp y.property).1
    exact hx.trans hy.symm
  · exact h

private theorem J_boundaries :
    Finite J ∧ ¬ J.Normal ∧ ¬ IsOpen (J : Set M) ∧ Infinite (M ⧸ J) ∧
      J.index = 0 ∧ ¬ J.FiniteIndex ∧ ¬ DiscreteTopology (M ⧸ J) ∧
      ¬ ContinuousConstSMul Mᵐᵒᵖ M ∧ ¬ SeparatelyContinuousMul M ∧
      ¬ Continuous (fun x : M × M => x.1 * x.2) ∧
      ¬ Continuous (fun x : M => x⁻¹) := by
  exact ⟨J_finite, J_not_normal, J_not_open, J_quotient_infinite, J_index_zero,
    J_not_finiteIndex, J_quotient_not_discrete, partition_product_no_right_action,
    partition_product_not_separately_continuous, partition_product_mul_not_continuous,
    partition_product_inverse_not_continuous⟩

private theorem first_coordinate_smul (g : M) (q : M ⧸ J) :
    first_coordinate (g • q) = g.1 * first_coordinate q := by
  refine QuotientGroup.induction_on q fun x => ?_
  (simp only [MulAction.Quotient.smul_mk, smul_eq_mul, first_coordinate_mk]; rfl)

private theorem J_fixed_action (g : M) : Continuous (fun q : M ⧸ J => g • q) := by
  let : ContinuousConstSMul M (M ⧸ J) := QuotientGroup.continuousConstSMul J
  exact continuous_const_smul g

private theorem J_projection_clients (g : M) :
    Continuous (MulActionHom.toQuotient J : M → M ⧸ J) ∧
      Function.Semiconj (QuotientGroup.mk : M → M ⧸ J)
        (fun x : M => g * x) (fun q : M ⧸ J => g • q) ∧
      MulAction.stabilizer M (QuotientGroup.mk (1 : M) : M ⧸ J) = J := by
  exact ⟨QuotientGroup.continuous_mk, projection_semiconj J g,
    MulAction.stabilizer_quotient J⟩

private theorem J_stabilizer_element :
    ((1 : A), tau) ≠ (1 : M) ∧
      ((1 : A), tau) • (QuotientGroup.mk (1 : M) : M ⧸ J) = QuotientGroup.mk 1 := by
  refine ⟨?_, ?_⟩
  · intro h
    exact (by decide : tau ≠ (1 : P)) (congrArg Prod.snd h)
  · simp only [MulAction.Quotient.smul_mk, smul_eq_mul, mul_one]
    apply QuotientGroup.eq.mpr
    simp [J, K, Subgroup.mem_prod]

private theorem J_observed_action (g : M) :
    Continuous (fun q : M ⧸ J => first_coordinate (g • q)) ∧
      (∀ q : M ⧸ J, first_coordinate (g • q) = g.1 * first_coordinate q) := by
  exact ⟨first_coordinate_continuous.comp (J_fixed_action g), first_coordinate_smul g⟩

private theorem J_translation_moves (a : A) (ha : a ≠ 1) :
    (a, (1 : P)) • (QuotientGroup.mk (1 : M) : M ⧸ J) ≠ QuotientGroup.mk 1 := by
  intro h
  have heq := congrArg first_coordinate h
  simp only [first_coordinate_smul, first_coordinate_mk] at heq
  change a * 1 = 1 at heq
  exact ha (by simpa only [mul_one] using heq)

private theorem J_nontrivial_observed_translation :
    Continuous (fun q : M ⧸ J => (Multiplicative.ofAdd (1 : ℤ), (1 : P)) • q) ∧
      first_coordinate ((Multiplicative.ofAdd (1 : ℤ), (1 : P)) •
        (QuotientGroup.mk (1 : M) : M ⧸ J)) ≠
          first_coordinate (QuotientGroup.mk (1 : M) : M ⧸ J) := by
  refine ⟨J_fixed_action _, ?_⟩
  simp only [first_coordinate_smul, first_coordinate_mk]
  change Multiplicative.ofAdd (1 : ℤ) * 1 ≠ 1
  rw [mul_one]
  exact fun h => (by norm_num : (1 : ℤ) ≠ 0) (ofAdd_eq_one.mp h)

end PartitionProduct

-- Conjugate containment, not inclusion, controls maps between left-coset actions.
private theorem conjugate_coset_hom_exists_not_le :
    Nonempty ((P ⧸ K.map (MulAut.conj sigma).toMonoidHom) →[P] (P ⧸ K)) ∧
      ¬ K.map (MulAut.conj sigma).toMonoidHom ≤ K := by
  constructor
  · exact (MulActionHom.nonempty_quotient_iff_exists_le_map_conj _ _).mpr ⟨sigma, le_rfl⟩
  · intro h
    have htau : sigma * tau * sigma⁻¹ ∈ K.map (MulAut.conj sigma).toMonoidHom :=
      ⟨tau, Subgroup.mem_zpowers tau, rfl⟩
    exact (by decide : (sigma * tau * sigma⁻¹) (2 : Fin 3) ≠ 2)
      (K_fixes_two (h htau))

private theorem no_coset_hom_to_bottom :
    ¬ Nonempty ((P ⧸ K) →[P] (P ⧸ (⊥ : Subgroup P))) := by
  rw [MulActionHom.nonempty_quotient_iff_exists_le_map_conj]
  rintro ⟨g, hg⟩
  have htau := hg (Subgroup.mem_zpowers tau)
  rw [Subgroup.map_bot, Subgroup.mem_bot] at htau
  exact (by decide : tau ≠ (1 : P)) htau

end GroupTheoryTest.Topology.Algebra.Group.Quotient

namespace GroupTheoryTest.Topology.Algebra.Group.Quotient

open CategoryTheory

-- The same nonnormal subgroup and its conjugate give an actual controlled isomorphism.
private noncomputable def conjugateCosetIso :
    Action.ofMulAction P (P ⧸ K.map (MulAut.conj sigma).toMonoidHom) ≅
      Action.ofMulAction P (P ⧸ K) :=
  Action.quotientIsoOfEqMapConj _ _ sigma rfl

private theorem conjugate_coset_iso_characteristic :
    conjugateCosetIso.hom.hom (QuotientGroup.mk tau) = QuotientGroup.mk (tau * sigma) ∧
      conjugateCosetIso.inv.hom (QuotientGroup.mk tau) = QuotientGroup.mk (tau * sigma) ∧
      conjugateCosetIso.hom.hom (QuotientGroup.mk (1 : P)) = QuotientGroup.mk sigma := by
  refine ⟨Action.quotientIsoOfEqMapConj_hom_mk _ _ sigma rfl tau, ?_,
    Action.quotientIsoOfEqMapConj_hom_one _ _ sigma rfl⟩
  have hs : sigma⁻¹ = sigma := by simp only [sigma, Equiv.swap_inv]
  have hi := Action.quotientIsoOfEqMapConj_inv_mk
    (K.map (MulAut.conj sigma).toMonoidHom) K sigma rfl tau
  rw [hs] at hi
  exact hi

-- Isomorphism needs conjugacy, not inclusion or normality.
private theorem conjugate_coset_iso_exists_not_le :
    Nonempty (Action.ofMulAction P (P ⧸ K.map (MulAut.conj sigma).toMonoidHom) ≅
      Action.ofMulAction P (P ⧸ K)) ∧
      ¬ K.map (MulAut.conj sigma).toMonoidHom ≤ K ∧ ¬ K.Normal := by
  exact ⟨(Action.nonempty_quotient_iso_iff_exists_eq_map_conj _ _).mpr ⟨sigma, rfl⟩,
    conjugate_coset_hom_exists_not_le.2, partition_K_not_normal⟩

private theorem identity_coset_iso_characteristic :
    (Action.quotientIsoOfEqMapConj K K (1 : P) (by simp)).hom.hom
        (QuotientGroup.mk tau) = (QuotientGroup.mk tau : P ⧸ K) ∧
      (Action.quotientIsoOfEqMapConj K K (1 : P) (by simp)).inv.hom
        (QuotientGroup.mk tau) = (QuotientGroup.mk tau : P ⧸ K) := by
  constructor
  · simpa only [mul_one] using
      Action.quotientIsoOfEqMapConj_hom_mk K K (1 : P) (by simp) tau
  · simpa only [inv_one, mul_one] using
      Action.quotientIsoOfEqMapConj_inv_mk K K (1 : P) (by simp) tau

private theorem no_coset_iso_to_bottom :
    ¬ Nonempty (Action.ofMulAction P (P ⧸ K) ≅
      Action.ofMulAction P (P ⧸ (⊥ : Subgroup P))) := by
  intro h
  obtain ⟨g, hg⟩ := (Action.nonempty_quotient_iso_iff_exists_eq_map_conj K ⊥).mp h
  exact no_coset_hom_to_bottom
    ((MulActionHom.nonempty_quotient_iff_exists_le_map_conj K ⊥).mpr ⟨g, hg.le⟩)

end GroupTheoryTest.Topology.Algebra.Group.Quotient
