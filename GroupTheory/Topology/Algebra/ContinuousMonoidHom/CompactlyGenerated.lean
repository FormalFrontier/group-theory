module

public import GroupTheory.Topology.Algebra.ContinuousMonoidHom.CompactFamilies
public import GroupTheory.Topology.Algebra.ContinuousMonoidHom.CompactNeighborhoods
public import GroupTheory.Topology.Algebra.Group.NoSmallSubgroups
public import GroupTheory.Topology.Algebra.MonoidHom.CompactBounds

/-!
# Local compactness of homomorphisms from compactly generated groups

If a locally compact group is algebraically generated by a compact set, its continuous
homomorphisms into a locally compact group with no small subgroups form a locally compact
space in the compact-open topology. No separation assumption on the source, commutativity
of the target, or group structure on the homomorphism space is required.

The proof constructs a closed neighborhood by imposing common compact bounds on a source
identity neighborhood and on the generators. The compact bounds propagate through the
algebraic subgroup generated by the latter set.

## References

This proof uses the compact-neighborhood assembly and compact-family criterion in the
imported continuous-monoid-hom modules, the compact closed subgroup-free neighborhood
criterion in the no-small-subgroups module, and the algebraic compact-bound and compact
power-control results in the imported monoid-hom modules.
-/

@[expose] public section

open Set Filter Topology

universe u v

/-- The compact-open space of continuous homomorphisms from a locally compact group
algebraically generated by a compact set into a locally compact group with no small
subgroups is locally compact. -/
theorem ContinuousMonoidHom.locallyCompactSpace_of_compact_generatingSet
    {G : Type u} {D : Type v}
    [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [LocallyCompactSpace G]
    [Group D] [TopologicalSpace D] [IsTopologicalGroup D]
    [LocallyCompactSpace D] [NoSmallSubgroups D]
    (s : Set G) (hs : IsCompact s) (hgen : Subgroup.closure s = ⊤) :
    LocallyCompactSpace (G →ₜ* D) := by
  let _ : T2Space D := inferInstance
  let _ : T2Space (G →ₜ* D) := inferInstance
  obtain ⟨K, hKnhds, hKcompact, hKclosed, hKfree⟩ :=
    noSmallSubgroups_iff_exists_isCompact_isClosed_nhds_one.mp
      (inferInstance : NoSmallSubgroups D)
  have hcompactNhds : ∀ f₀ : G →ₜ* D,
      ∃ B : Set (G →ₜ* D), IsCompact B ∧ B ∈ nhds f₀ := by
    intro f₀
    obtain ⟨Q, hQnhds, _, P, hPcompact, hN⟩ :=
      ContinuousMonoidHom.exists_isCompact_bounds_mem_nhds f₀ s hs K hKnhds
    let B : Set (G →ₜ* D) := {f | MapsTo f Q K ∧ MapsTo f s P}
    have hBnhds : B ∈ nhds f₀ := hN
    have heval (x : G) : Continuous (fun f : G →ₜ* D => f x) := by
      apply continuous_def.mpr
      intro V hV
      have hopen : IsOpen {f : C(G, D) | MapsTo f ({x} : Set G) V} :=
        ContinuousMap.isOpen_setOfPred_mapsTo isCompact_singleton hV
      have hpre : (fun f : G →ₜ* D => f x) ⁻¹' V =
          (fun f : G →ₜ* D => f.toContinuousMap) ⁻¹'
            {f : C(G, D) | MapsTo f ({x} : Set G) V} := by
        ext f
        constructor
        · intro hf y hy
          have hyx : y = x := Set.mem_singleton_iff.mp hy
          subst y
          exact hf
        · intro hf
          exact hf (by rfl)
      rw [hpre]
      exact hopen.preimage
        (ContinuousMonoidHom.isInducing_toContinuousMap G D).continuous
    have hmapsClosed (t : Set G) (R : Set D) (hR : IsClosed R) :
        IsClosed {f : G →ₜ* D | MapsTo f t R} := by
      have heq : {f : G →ₜ* D | MapsTo f t R} =
          ⋂ x : G, ⋂ (_ : x ∈ t), (fun f : G →ₜ* D => f x) ⁻¹' R := by
        ext f
        constructor
        · intro hf
          apply mem_iInter.mpr
          intro x
          apply mem_iInter.mpr
          intro hx
          exact hf hx
        · intro hf x hx
          exact mem_iInter.mp (mem_iInter.mp hf x) hx
      rw [heq]
      exact isClosed_iInter fun x =>
        isClosed_iInter fun _ => hR.preimage (heval x)
    have hBclosed : IsClosed B :=
      (hmapsClosed Q K hKclosed).inter (hmapsClosed s P hPcompact.isClosed)
    have hpoint : ∀ x : G, ∃ R : Set D,
        IsCompact R ∧ ∀ f ∈ B, f x ∈ R := by
      intro x
      have hbound : ∀ y ∈ s, ∃ R : Set D,
          IsCompact R ∧ ∀ f : B, f.val.toMonoidHom y ∈ R := by
        intro y hy
        exact ⟨P, hPcompact, fun f => f.property.2 hy⟩
      have hx : x ∈ Subgroup.closure s := by
        rw [hgen]
        exact Subgroup.mem_top x
      obtain ⟨R, hRcompact, hRbound⟩ :=
        MonoidHom.exists_isCompact_bound_of_mem_closure
          (fun f : B => f.val.toMonoidHom) hbound hx
      exact ⟨R, hRcompact, fun f hf => hRbound ⟨f, hf⟩⟩
    have hBcompact : IsCompact B :=
      ContinuousMonoidHom.isCompact_of_isClosed_of_mapsTo
        B hBclosed hQnhds hKcompact hKfree (fun f hf => hf.1) hpoint
    exact ⟨B, hBcompact, hBnhds⟩
  let _ : WeaklyLocallyCompactSpace (G →ₜ* D) := ⟨hcompactNhds⟩
  infer_instance
