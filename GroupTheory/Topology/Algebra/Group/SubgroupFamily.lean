module

public import Mathlib.Algebra.Group.Subgroup.Defs
public import Mathlib.Order.Filter.Bases.Finite
public import Mathlib.Topology.Algebra.FilterBasis
public import Mathlib.Topology.Algebra.IsUniformGroup.Defs

/-!
# Additive group filter bases generated by subgroup families

An arbitrary family of additive subgroups of an additive commutative group determines
an additive group filter basis. Its basic sets are finite intersections of members of
the family, including the empty intersection, which is the whole group. No directedness
or nonemptiness assumption on the index type is required.

`AddSubgroup.familyBasis` uses Mathlib's `FilterBasis.ofSets` and
`addGroupFilterBasisOfComm`. Its associated topology is the stock
`AddGroupFilterBasis.topology`. The zero neighborhoods have a basis indexed by finite
sets of the original index type. In particular, an empty family gives the indiscrete
topology, not the discrete topology.

Commutativity supplies the conjugation axiom of the group filter basis. For a
noncommutative additive group, an additional conjugation-cofinality condition would
be necessary; closure under addition and negation alone does not supply it.
-/

@[expose] public section

open Filter Set
open scoped Pointwise Topology

universe uM uI

namespace AddSubgroup

variable {M : Type uM} {I : Type uI} [g : AddCommGroup M]

/-- The additive group filter basis generated by an arbitrary family of additive
subgroups. Its sets are all finite intersections of members of the family, including
`univ`. The original additive group is unchanged; `.topology` supplies an associated
topology, without replacing any pre-existing topology on the carrier. -/
@[instance_reducible]
def familyBasis (H : I → AddSubgroup M) : @AddGroupFilterBasis M g.toAddGroup :=
  @addGroupFilterBasisOfComm M g
    (FilterBasis.ofSets (Set.range fun i => (H i : Set M))).sets
    (FilterBasis.ofSets (Set.range fun i => (H i : Set M))).nonempty
    (fun _ _ hU hV =>
      (FilterBasis.ofSets (Set.range fun i => (H i : Set M))).inter_sets hU hV)
    (by
      rintro U ⟨S, ⟨_, hSH⟩, rfl⟩
      refine Set.mem_sInter.mpr ?_
      intro V hV
      rcases hSH hV with ⟨i, rfl⟩
      exact (H i).zero_mem)
    (by
      intro U hU
      refine ⟨U, hU, ?_⟩
      rcases hU with ⟨S, ⟨_, hSH⟩, rfl⟩
      rintro x ⟨a, ha, b, hb, rfl⟩
      refine Set.mem_sInter.mpr ?_
      intro V hV
      rcases hSH hV with ⟨i, rfl⟩
      exact (H i).add_mem (Set.mem_sInter.mp ha _ hV) (Set.mem_sInter.mp hb _ hV))
    (by
      intro U hU
      refine ⟨U, hU, ?_⟩
      rcases hU with ⟨S, ⟨_, hSH⟩, rfl⟩
      intro x hx
      refine Set.mem_sInter.mpr ?_
      intro V hV
      rcases hSH hV with ⟨i, rfl⟩
      exact (H i).neg_mem (Set.mem_sInter.mp hx _ hV))

/-- The zero-neighborhood filter of the topology generated by a subgroup family is
the infimum of the principal filters of the original subgroups. This includes an
empty infimum, which is the top filter. -/
theorem familyBasis_nhds_zero_eq_iInf (H : I → AddSubgroup M) :
    @nhds M (familyBasis H).topology (0 : M) = ⨅ i, 𝓟 (H i : Set M) := by
  rw [AddGroupFilterBasis.nhds_zero_eq]
  change (FilterBasis.ofSets (Set.range fun i => (H i : Set M))).filter = _
  rw [Filter.ofSets_filter_eq_generate]
  apply le_antisymm
  · refine le_iInf fun i => ?_
    exact Filter.le_principal_iff.mpr (Filter.mem_generate_of_mem ⟨i, rfl⟩)
  · refine Filter.le_generate_iff.mpr ?_
    rintro U ⟨i, rfl⟩
    exact Filter.le_principal_iff.mp (iInf_le (fun i => 𝓟 (H i : Set M)) i)

/-- Finite intersections indexed by finite sets of the original index type form a
basis of zero neighborhoods. The empty finite set contributes `univ`. -/
theorem familyBasis_nhds_zero_hasBasis (H : I → AddSubgroup M) :
    (@nhds M (familyBasis H).topology (0 : M)).HasBasis
      (fun J : Set I => J.Finite) (fun J => ⋂ i ∈ J, (H i : Set M)) := by
  rw [familyBasis_nhds_zero_eq_iInf]
  exact Filter.hasBasis_iInf_principal_finite (fun i => (H i : Set M))

/-- The right uniformity of the topology generated by a subgroup family is the
infimum of the principal filters requiring the difference of the two coordinates
to lie in each original subgroup. -/
theorem familyBasis_uniformity_eq_iInf (H : I → AddSubgroup M) :
    (@IsTopologicalAddGroup.rightUniformSpace M g.toAddGroup
      (familyBasis H).topology
      (@AddGroupFilterBasis.isTopologicalAddGroup M g.toAddGroup
        (familyBasis H))).uniformity =
      ⨅ i, 𝓟 {p : M × M | p.2 - p.1 ∈ H i} := by
  change Filter.comap (fun p : M × M => p.2 + -p.1)
    (@nhds M (familyBasis H).topology 0) = _
  rw [familyBasis_nhds_zero_eq_iInf, Filter.comap_iInf]
  simp only [Filter.comap_principal, sub_eq_add_neg]
  rfl

/-- Finite intersections of the difference relations of the original subgroups
form a basis of entourages for the right uniformity. The empty finite set
contributes the universal relation. -/
theorem familyBasis_uniformity_hasBasis (H : I → AddSubgroup M) :
    ((@IsTopologicalAddGroup.rightUniformSpace M g.toAddGroup
      (familyBasis H).topology
      (@AddGroupFilterBasis.isTopologicalAddGroup M g.toAddGroup
        (familyBasis H))).uniformity).HasBasis
      (fun J : Set I => J.Finite)
      (fun J => ⋂ i ∈ J, {p : M × M | p.2 - p.1 ∈ H i}) := by
  rw [familyBasis_uniformity_eq_iInf]
  exact Filter.hasBasis_iInf_principal_finite (fun i => {p : M × M | p.2 - p.1 ∈ H i})

/-- The closure of zero in the topology generated by a subgroup family is the
intersection of the original subgroups. In particular, an empty family has the
whole group as the closure of zero. -/
theorem familyBasis_closure_zero_eq_iInter (H : I → AddSubgroup M) :
    @_root_.closure M (familyBasis H).topology ({0} : Set M) = ⋂ i, (H i : Set M) := by
  ext x
  have hb := @Filter.HasBasis.nhds_of_zero M (familyBasis H).topology g.toAddGroup
    (@AddGroupFilterBasis.isTopologicalAddGroup M g.toAddGroup (familyBasis H))
    _ _ _ (familyBasis_nhds_zero_hasBasis H) x
  rw [@mem_closure_iff_nhds_basis M (familyBasis H).topology _ _ _ _ _ hb]
  simp only [Set.mem_singleton_iff, exists_eq_left, Set.mem_ofPred_eq, Set.mem_iInter, zero_sub]
  constructor
  · intro hx i
    exact (H i).neg_mem_iff.mp (hx {i} (Set.finite_singleton i) i (Set.mem_singleton i))
  · intro hx J _ i _
    exact (H i).neg_mem_iff.mpr (hx i)

end AddSubgroup
