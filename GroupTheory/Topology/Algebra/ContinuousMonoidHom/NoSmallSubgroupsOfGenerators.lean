module

public import GroupTheory.Topology.Algebra.ContinuousMap.NoSmallSubgroups
public import GroupTheory.Topology.Algebra.ContinuousMonoidHom.NoSmallSubgroups
public import Mathlib.Algebra.Group.Subgroup.Ker
public import Mathlib.GroupTheory.Finiteness
public import Mathlib.Topology.Algebra.ContinuousMonoidHom
public import Mathlib.Topology.Algebra.Group.CompactOpen
public import Mathlib.Topology.CompactOpen
public import Mathlib.Topology.Compactness.Compact
public import Mathlib.Topology.ContinuousMap.Algebra
public import Mathlib.Topology.ContinuousMap.Basic
public import Mathlib.Topology.ContinuousMap.Defs
public import Mathlib.Topology.Maps.Basic

/-!
# No small subgroups for homomorphisms from compact generators

For a commutative topological group with no small subgroups, restriction to a
compact algebraic generating set gives a continuous injective homomorphism from
the compact-open homomorphism group to the group of continuous maps on a compact
space. The latter has no small subgroups, and
`NoSmallSubgroups.of_injective` transfers this property to the homomorphism group.

* `ContinuousMonoidHom.noSmallSubgroups_of_isCompact_generating` applies to a
  group with a compact subset whose algebraic subgroup closure is the whole group.
* `ContinuousMonoidHom.noSmallSubgroups_of_fg` applies to a finitely generated
  group with any topology.

No continuity of the source group operations is assumed. Target commutativity
is needed for the pointwise group structure on continuous homomorphisms. These
results do not replace the stronger compact-monoid-source conclusions of
`ContinuousMonoidHom.isOpen_singleton_one_of_noSmallSubgroups` and
`ContinuousMonoidHom.discreteTopology_of_noSmallSubgroups`.
-/

@[expose] public section

universe u v

namespace ContinuousMonoidHom

variable {G : Type u} {D : Type v} [Group G] [TopologicalSpace G]
  [CommGroup D] [TopologicalSpace D] [IsTopologicalGroup D] [NoSmallSubgroups D]

/-- Continuous homomorphisms into a commutative topological group with no small
subgroups have no small subgroups if their source is algebraically generated by
a compact subset. The source topology need not make its group operations continuous. -/
theorem noSmallSubgroups_of_isCompact_generating
    (K : Set G) (hK : IsCompact K) (hgen : Subgroup.closure K = ⊤) :
    NoSmallSubgroups (G →ₜ* D) := by
  let _ : CompactSpace K := isCompact_iff_compactSpace.mp hK
  let r : (G →ₜ* D) → C(K, D) := fun f => f.toContinuousMap.restrict K
  have hr_apply (f : G →ₜ* D) (x : K) : r f x = f (x : G) := by
    exact (ContinuousMap.restrict_apply f.toContinuousMap K x).trans
      (DFunLike.congr_fun (coe_toContinuousMap f) (x : G))
  have hr_mul (f g : G →ₜ* D) : r (f * g) = r f * r g := by
    apply ContinuousMap.ext
    intro x
    simp only [hr_apply, ContinuousMap.mul_apply, ContinuousMonoidHom.mul_apply]
  -- A multiplicative map into a group preserves the identity by cancellation.
  have hr_one : r 1 = 1 := by
    have h : r 1 * r 1 = r 1 * 1 := by
      calc
        r 1 * r 1 = r (1 * 1) := (hr_mul 1 1).symm
        _ = r 1 * 1 := by simp only [mul_one]
    exact mul_left_cancel h
  let R : (G →ₜ* D) →* C(K, D) :=
    { toFun := r
      map_one' := hr_one
      map_mul' := hr_mul }
  have hforget : Continuous (toContinuousMap : (G →ₜ* D) → C(G, D)) :=
    (isInducing_toContinuousMap G D).continuous
  have hR_cont : Continuous R :=
    (ContinuousMap.continuous_restrict K).comp hforget
  have hR_inj : Function.Injective R := by
    intro f g hfg
    have hfg' : r f = r g := hfg
    have hKfg : Set.EqOn f.toMonoidHom g.toMonoidHom K := by
      intro x hx
      calc
        f.toMonoidHom x = f x := DFunLike.congr_fun (coe_toMonoidHom f) x
        _ = r f ⟨x, hx⟩ := (hr_apply f ⟨x, hx⟩).symm
        _ = r g ⟨x, hx⟩ :=
          congrArg (fun F : C(K, D) => F ⟨x, hx⟩) hfg'
        _ = g x := hr_apply g ⟨x, hx⟩
        _ = g.toMonoidHom x := (DFunLike.congr_fun (coe_toMonoidHom g) x).symm
    have hclosure := MonoidHom.eqOn_closure hKfg
    rw [hgen] at hclosure
    apply ContinuousMonoidHom.ext
    intro x
    calc
      f x = f.toMonoidHom x := (DFunLike.congr_fun (coe_toMonoidHom f) x).symm
      _ = g.toMonoidHom x := hclosure (by trivial)
      _ = g x := DFunLike.congr_fun (coe_toMonoidHom g) x
  exact NoSmallSubgroups.of_injective R hR_cont.continuousAt hR_inj

/-- Continuous homomorphisms from a finitely generated group, with any topology,
into a commutative topological group with no small subgroups have no small subgroups. -/
theorem noSmallSubgroups_of_fg [Group.FG G] :
    NoSmallSubgroups (G →ₜ* D) := by
  obtain ⟨K, hgen, hK⟩ := (Group.fg_iff (G := G)).mp inferInstance
  exact noSmallSubgroups_of_isCompact_generating (D := D) K hK.isCompact hgen

end ContinuousMonoidHom
