module

public import Mathlib.Topology.Algebra.Group.CompactOpen
public import Mathlib.Topology.Homeomorph.Lemmas

/-!
# Equivalences of continuous homomorphism spaces

A continuous multiplicative equivalence acts on continuous homomorphisms by
postcomposition. This is a homeomorphism for arbitrary monoids with topologies,
with no continuity assumption on their operations. For commutative codomains with
continuous multiplication, it is a continuous multiplicative equivalence.

The constructions use Mathlib's induced compact-open topology and its continuity
of fixed postcomposition. The multiplicative construction agrees with Mathlib's
`ContinuousMonoidHom.compRight` when the codomains are commutative topological groups.
Precomposition with the inverse of a continuous multiplicative equivalence likewise
gives domain transport, agreeing with Mathlib's algebraic domain congruence and,
for a commutative topological-group target, `ContinuousMonoidHom.compLeft`.
Coordinatewise equivalences lift to arbitrary dependent products, using Mathlib's
`MulEquiv.piCongrRight` and `Homeomorph.piCongrRight` data. These constructions
retain the original algebraic structures and topologies. Additive counterparts
of the transport and coordinatewise constructions are generated by `to_additive`.

For monoids `A` and `B` with topologies and a commutative topological group `E`,
Mathlib's coproduct identifies pairs of continuous homomorphisms into `E` with
continuous homomorphisms from `A × B`. The inverse restricts along the two factor
inclusions. Both sides retain their compact-open topologies; no continuity of the
source operations, source separation or local compactness is assumed. The algebraic
coproduct and restriction universal property only needs a commutative monoid `E`
with continuous multiplication.

## Main definitions

* `ContinuousMulEquiv.continuousMonoidHomCongrLeftHomeomorph`: domain transport
  on compact-open hom spaces, without continuous-operation hypotheses.
* `ContinuousMulEquiv.continuousMonoidHomCongrLeft`: its multiplicative refinement.
* `ContinuousMulEquiv.piCongrRight`: coordinatewise continuous multiplicative transport.
* `ContinuousMonoidHom.coprodContinuousMulEquiv`: the coproduct equivalence for
  compact-open continuous homomorphism spaces.

## References

* Mathlib's `Algebra.Group.Equiv.Basic` (Johannes Hölzl, Callum Sutton and
  Yury Kudryashov), for algebraic domain and dependent-product congruences.
* Mathlib's `Topology.Homeomorph.Lemmas` (Johannes Hölzl, Patrick Massot,
  Sébastien Gouëzel, Zhouhang Zhou and Reid Barton), for the Pi homeomorphism.
* Mathlib's `ContinuousMonoidHom.coprod`, `prodMap`, `inl`, and `inr` in
  `Topology.Algebra.ContinuousMonoidHom`, and fixed precomposition in
  `Topology.Algebra.Group.CompactOpen`.
* Mathlib's `MonoidHom.coprod` and `MonoidHom.coprod_unique` in `Algebra.Group.Prod`,
  for the algebraic coproduct and its universal property.
-/

@[expose] public section

universe u v w z

namespace ContinuousMulEquiv

variable (A : Type u) [Monoid A] [TopologicalSpace A]
variable {B : Type v} {C : Type w} {D : Type z}
variable [TopologicalSpace B] [TopologicalSpace C] [TopologicalSpace D]

section Monoid

variable [Monoid B] [Monoid C] [Monoid D]

/-- Postcomposition by a continuous multiplicative equivalence is a homeomorphism
of continuous homomorphism spaces, with their induced compact-open topologies. -/
@[to_additive /-- Postcomposition by a continuous additive equivalence is a homeomorphism
of continuous additive homomorphism spaces, with their induced compact-open topologies. -/]
def continuousMonoidHomCongrRightHomeomorph (e : B ≃ₜ* C) :
    (A →ₜ* B) ≃ₜ (A →ₜ* C) where
  toFun χ := (e : B →ₜ* C).comp χ
  invFun χ := (e.symm : C →ₜ* B).comp χ
  left_inv χ := ContinuousMonoidHom.ext fun a => e.symm_apply_apply (χ a)
  right_inv χ := ContinuousMonoidHom.ext fun a => e.apply_symm_apply (χ a)
  continuous_toFun := ContinuousMonoidHom.continuous_comp_right _
  continuous_invFun := ContinuousMonoidHom.continuous_comp_right _

@[to_additive (attr := simp)]
theorem continuousMonoidHomCongrRightHomeomorph_apply (e : B ≃ₜ* C) (χ : A →ₜ* B) :
    continuousMonoidHomCongrRightHomeomorph A e χ = (e : B →ₜ* C).comp χ := rfl

@[to_additive (attr := simp)]
theorem continuousMonoidHomCongrRightHomeomorph_symm_apply (e : B ≃ₜ* C) (χ : A →ₜ* C) :
    (continuousMonoidHomCongrRightHomeomorph A e).symm χ =
      (e.symm : C →ₜ* B).comp χ := rfl

/-- Identity codomain transport induces the identity homeomorphism. -/
@[to_additive (attr := simp) /-- Identity codomain transport induces the identity homeomorphism. -/]
theorem continuousMonoidHomCongrRightHomeomorph_refl :
    continuousMonoidHomCongrRightHomeomorph A (ContinuousMulEquiv.refl B) =
      Homeomorph.refl (A →ₜ* B) := by
  ext χ a
  rfl

/-- Successive codomain transports agree with transport along the composite. -/
@[to_additive /-- Successive codomain transports agree with transport along the composite. -/]
theorem continuousMonoidHomCongrRightHomeomorph_trans (e : B ≃ₜ* C) (f : C ≃ₜ* D) :
    continuousMonoidHomCongrRightHomeomorph A (e.trans f) =
      (continuousMonoidHomCongrRightHomeomorph A e).trans
        (continuousMonoidHomCongrRightHomeomorph A f) := by
  ext χ a
  rfl

end Monoid

section CommMonoid

variable [CommMonoid B] [CommMonoid C] [CommMonoid D]
variable [ContinuousMul B] [ContinuousMul C] [ContinuousMul D]

/-- Postcomposition by a continuous multiplicative equivalence, as a continuous
multiplicative equivalence of continuous homomorphism spaces. -/
@[to_additive /-- Postcomposition by a continuous additive equivalence, as a continuous
additive equivalence of continuous additive homomorphism spaces. -/]
def continuousMonoidHomCongrRight (e : B ≃ₜ* C) : (A →ₜ* B) ≃ₜ* (A →ₜ* C) :=
  ContinuousMulEquiv.mk' (continuousMonoidHomCongrRightHomeomorph A e) (by
    intro χ ψ
    exact ContinuousMonoidHom.ext fun a => map_mul e (χ a) (ψ a))

@[to_additive (attr := simp)]
theorem continuousMonoidHomCongrRight_apply (e : B ≃ₜ* C) (χ : A →ₜ* B) :
    continuousMonoidHomCongrRight A e χ = (e : B →ₜ* C).comp χ := rfl

@[to_additive (attr := simp)]
theorem continuousMonoidHomCongrRight_symm_apply (e : B ≃ₜ* C) (χ : A →ₜ* C) :
    (continuousMonoidHomCongrRight A e).symm χ = (e.symm : C →ₜ* B).comp χ := rfl

/-- Identity codomain transport induces the identity continuous multiplicative equivalence. -/
@[to_additive (attr := simp) /-- Identity codomain transport induces the identity continuous
additive equivalence. -/]
theorem continuousMonoidHomCongrRight_refl :
    continuousMonoidHomCongrRight A (ContinuousMulEquiv.refl B) =
      ContinuousMulEquiv.refl (A →ₜ* B) := by
  ext χ a
  rfl

/-- Successive codomain transports agree with transport along the composite. -/
@[to_additive /-- Successive codomain transports agree with transport along the composite. -/]
theorem continuousMonoidHomCongrRight_trans (e : B ≃ₜ* C) (f : C ≃ₜ* D) :
    continuousMonoidHomCongrRight A (e.trans f) =
      (continuousMonoidHomCongrRight A e).trans (continuousMonoidHomCongrRight A f) := by
  ext χ a
  rfl

end CommMonoid

section CommGroup

variable [CommGroup B] [CommGroup C] [IsTopologicalGroup B] [IsTopologicalGroup C]

/-- For commutative topological groups, the homomorphism underlying codomain transport
is Mathlib's bundled postcomposition map. -/
@[to_additive /-- For commutative topological additive groups, the homomorphism underlying
codomain transport is Mathlib's bundled postcomposition map. -/]
theorem continuousMonoidHomCongrRight_toContinuousMonoidHom (e : B ≃ₜ* C) :
    (continuousMonoidHomCongrRight A e : (A →ₜ* B) →ₜ* (A →ₜ* C)) =
      ContinuousMonoidHom.compRight A (e : B →ₜ* C) := by
  ext χ a
  rfl

end CommGroup

end ContinuousMulEquiv

namespace ContinuousMonoidHom

section Product

variable {A : Type u} {B : Type v} {C : Type w} {D : Type z}
variable [Monoid A] [Monoid B] [Monoid C] [Monoid D]
variable [TopologicalSpace A] [TopologicalSpace B] [TopologicalSpace C] [TopologicalSpace D]

/-- A product map applies each continuous homomorphism to its coordinate. -/
@[simp]
theorem prodMap_apply (f : A →ₜ* C) (g : B →ₜ* D) (x : A × B) :
    f.prodMap g x = (f x.1, g x.2) := rfl

/-- The left factor inclusion has one in the second coordinate. -/
@[simp]
theorem inl_apply (a : A) : inl A B a = (a, 1) := rfl

/-- The right factor inclusion has one in the first coordinate. -/
@[simp]
theorem inr_apply (b : B) : inr A B b = (1, b) := rfl

end Product

variable (A : Type u) (B : Type v) (E : Type w)
variable [Monoid A] [Monoid B] [TopologicalSpace A] [TopologicalSpace B]

variable {A B E} in
/-- Forgetting continuity sends a coproduct to the coproduct of monoid homomorphisms. -/
@[to_additive (attr := simp) /-- Forgetting continuity sends a coproduct to the coproduct
of additive monoid homomorphisms. -/]
theorem coe_coprod [CommMonoid E] [TopologicalSpace E] [ContinuousMul E]
    (f : A →ₜ* E) (g : B →ₜ* E) :
    (f.coprod g : (A × B) →* E) = (f : A →* E).coprod (g : B →* E) := by
  exact MonoidHom.ext fun _ => rfl

private theorem coprod_restrictions [CommMonoid E] [TopologicalSpace E] [ContinuousMul E]
    (f : A →ₜ* E) (g : B →ₜ* E) :
    ((f.coprod g).comp (inl A B), (f.coprod g).comp (inr A B)) = (f, g) := by
  apply Prod.ext
  · apply toMonoidHom_injective
    exact MonoidHom.coprod_comp_inl f.toMonoidHom g.toMonoidHom
  · apply toMonoidHom_injective
    exact MonoidHom.coprod_comp_inr f.toMonoidHom g.toMonoidHom

private theorem coprod_reconstruct [CommMonoid E] [TopologicalSpace E] [ContinuousMul E]
    (χ : (A × B) →ₜ* E) :
    (χ.comp (inl A B)).coprod (χ.comp (inr A B)) = χ := by
  apply toMonoidHom_injective
  exact MonoidHom.coprod_unique χ.toMonoidHom

section CommGroup

variable [CommGroup E] [TopologicalSpace E] [IsTopologicalGroup E]

/-- The coproduct of continuous homomorphisms into a commutative topological group
is a continuous multiplicative equivalence for the compact-open topologies. Its inverse restricts
along the two factor inclusions. -/
def coprodContinuousMulEquiv :
    ((A →ₜ* E) × (B →ₜ* E)) ≃ₜ* ((A × B) →ₜ* E) where
  toFun fg := fg.1.coprod fg.2
  invFun χ := (χ.comp (inl A B), χ.comp (inr A B))
  left_inv := by
    intro fg
    exact coprod_restrictions A B E fg.1 fg.2
  right_inv := by
    intro χ
    exact coprod_reconstruct A B E χ
  map_mul' := by
    intro fg hk
    exact ContinuousMonoidHom.ext fun ab =>
      mul_mul_mul_comm (fg.1 ab.1) (hk.1 ab.1) (fg.2 ab.2) (hk.2 ab.2)
  continuous_toFun := by
    -- Fixed pullbacks and pointwise multiplication need no source local compactness.
    change Continuous (fun fg : (A →ₜ* E) × (B →ₜ* E) =>
      fg.1.comp (fst A B) * fg.2.comp (snd A B))
    exact ((continuous_comp_left (C := E) (fst A B)).comp continuous_fst).mul
      ((continuous_comp_left (C := E) (snd A B)).comp continuous_snd)
  continuous_invFun := by
    exact (continuous_comp_left (C := E) (inl A B)).prodMk
      (continuous_comp_left (C := E) (inr A B))

/-- The forward map of the coproduct equivalence is the coproduct. -/
@[simp]
theorem coprodContinuousMulEquiv_apply (fg : (A →ₜ* E) × (B →ₜ* E)) :
    coprodContinuousMulEquiv A B E fg = fg.1.coprod fg.2 := rfl

/-- The inverse coproduct equivalence restricts to the factors. -/
@[simp]
theorem coprodContinuousMulEquiv_symm_apply (χ : (A × B) →ₜ* E) :
    (coprodContinuousMulEquiv A B E).symm χ =
      (χ.comp (inl A B), χ.comp (inr A B)) := rfl

/-- Evaluation of the coproduct equivalence is pointwise multiplication. -/
theorem coprodContinuousMulEquiv_apply_apply (fg : (A →ₜ* E) × (B →ₜ* E))
    (a : A) (b : B) :
    coprodContinuousMulEquiv A B E fg (a, b) = fg.1 a * fg.2 b := rfl

/-- Forgetting continuity gives the coproduct of monoid homomorphisms. -/
theorem coprodContinuousMulEquiv_toMonoidHom (fg : (A →ₜ* E) × (B →ₜ* E)) :
    (coprodContinuousMulEquiv A B E fg).toMonoidHom =
      fg.1.toMonoidHom.coprod fg.2.toMonoidHom := by
  exact MonoidHom.ext fun _ => rfl

end CommGroup

variable [CommMonoid E] [TopologicalSpace E] [ContinuousMul E]

/-- A continuous homomorphism out of a product is the coproduct of prescribed
factor maps exactly when its restrictions are those maps. -/
theorem coprod_eq_iff (f : A →ₜ* E) (g : B →ₜ* E) (χ : (A × B) →ₜ* E) :
    f.coprod g = χ ↔ χ.comp (inl A B) = f ∧ χ.comp (inr A B) = g := by
  constructor
  · rintro rfl
    have h := coprod_restrictions A B E f g
    exact ⟨congrArg Prod.fst h, congrArg Prod.snd h⟩
  · rintro ⟨hf, hg⟩
    rw [← hf, ← hg]
    exact coprod_reconstruct A B E χ

end ContinuousMonoidHom

namespace ContinuousMulEquiv

section Domain

variable (E : Type w) {A : Type u} {B : Type v} {C : Type z}
variable [Monoid A] [Monoid B] [Monoid C]
variable [TopologicalSpace A] [TopologicalSpace B] [TopologicalSpace C]

section Monoid

variable [Monoid E] [TopologicalSpace E]

/-- Precomposition with the inverse of a continuous multiplicative equivalence
is a homeomorphism of compact-open continuous homomorphism spaces. -/
@[to_additive /-- Precomposition with the inverse of a continuous additive equivalence
is a homeomorphism of compact-open continuous additive homomorphism spaces. -/]
def continuousMonoidHomCongrLeftHomeomorph (e : A ≃ₜ* B) :
    (A →ₜ* E) ≃ₜ (B →ₜ* E) where
  toFun χ := χ.comp (e.symm : B →ₜ* A)
  invFun χ := χ.comp (e : A →ₜ* B)
  left_inv χ := ContinuousMonoidHom.ext fun a => congrArg χ (e.symm_apply_apply a)
  right_inv χ := ContinuousMonoidHom.ext fun b => congrArg χ (e.apply_symm_apply b)
  continuous_toFun := ContinuousMonoidHom.continuous_comp_left _
  continuous_invFun := ContinuousMonoidHom.continuous_comp_left _

@[to_additive (attr := simp)]
theorem continuousMonoidHomCongrLeftHomeomorph_apply (e : A ≃ₜ* B) (χ : A →ₜ* E) :
    continuousMonoidHomCongrLeftHomeomorph E e χ = χ.comp (e.symm : B →ₜ* A) := rfl

@[to_additive (attr := simp)]
theorem continuousMonoidHomCongrLeftHomeomorph_symm_apply (e : A ≃ₜ* B) (χ : B →ₜ* E) :
    (continuousMonoidHomCongrLeftHomeomorph E e).symm χ = χ.comp (e : A →ₜ* B) := rfl

/-- Forgetting continuity commutes with domain transport. -/
@[to_additive /-- Forgetting continuity commutes with domain transport. -/]
theorem continuousMonoidHomCongrLeftHomeomorph_toMonoidHom
    (e : A ≃ₜ* B) (χ : A →ₜ* E) :
    (continuousMonoidHomCongrLeftHomeomorph E e χ).toMonoidHom =
      MulEquiv.monoidHomCongrLeftEquiv e.toMulEquiv χ.toMonoidHom := rfl

/-- The inverse transport also commutes with forgetting continuity. -/
@[to_additive /-- The inverse transport also commutes with forgetting continuity. -/]
theorem continuousMonoidHomCongrLeftHomeomorph_symm_toMonoidHom
    (e : A ≃ₜ* B) (χ : B →ₜ* E) :
    ((continuousMonoidHomCongrLeftHomeomorph E e).symm χ).toMonoidHom =
      (MulEquiv.monoidHomCongrLeftEquiv e.toMulEquiv).symm χ.toMonoidHom := rfl

/-- Identity domain transport is the identity homeomorphism. -/
@[to_additive (attr := simp) /-- Identity domain transport is the identity homeomorphism. -/]
theorem continuousMonoidHomCongrLeftHomeomorph_refl :
    continuousMonoidHomCongrLeftHomeomorph E (ContinuousMulEquiv.refl A) =
      Homeomorph.refl (A →ₜ* E) := by
  ext χ a
  rfl

/-- Successive domain transports agree with transport along their composite. -/
@[to_additive /-- Successive domain transports agree with transport along their composite. -/]
theorem continuousMonoidHomCongrLeftHomeomorph_trans (e : A ≃ₜ* B) (f : B ≃ₜ* C) :
    continuousMonoidHomCongrLeftHomeomorph E (e.trans f) =
      (continuousMonoidHomCongrLeftHomeomorph E e).trans
        (continuousMonoidHomCongrLeftHomeomorph E f) := by
  ext χ c
  rfl

end Monoid

section CommMonoid

variable [CommMonoid E] [TopologicalSpace E] [ContinuousMul E]

/-- Domain transport as a continuous multiplicative equivalence, with the same
homeomorphism as `continuousMonoidHomCongrLeftHomeomorph`. -/
@[to_additive /-- Domain transport as a continuous additive equivalence, with the same
homeomorphism as `continuousAddMonoidHomCongrLeftHomeomorph`. -/]
def continuousMonoidHomCongrLeft (e : A ≃ₜ* B) : (A →ₜ* E) ≃ₜ* (B →ₜ* E) :=
  ContinuousMulEquiv.mk' (continuousMonoidHomCongrLeftHomeomorph E e) (fun _ _ => rfl)

/-- The multiplicative transport retains the domain-transport homeomorphism. -/
@[to_additive (attr := simp) /-- The additive transport retains the domain-transport
homeomorphism. -/]
theorem continuousMonoidHomCongrLeft_toHomeomorph (e : A ≃ₜ* B) :
    (continuousMonoidHomCongrLeft E e).toHomeomorph =
      continuousMonoidHomCongrLeftHomeomorph E e := rfl

@[to_additive (attr := simp)]
theorem continuousMonoidHomCongrLeft_apply (e : A ≃ₜ* B) (χ : A →ₜ* E) :
    continuousMonoidHomCongrLeft E e χ = χ.comp (e.symm : B →ₜ* A) := rfl

@[to_additive (attr := simp)]
theorem continuousMonoidHomCongrLeft_symm_apply (e : A ≃ₜ* B) (χ : B →ₜ* E) :
    (continuousMonoidHomCongrLeft E e).symm χ = χ.comp (e : A →ₜ* B) := rfl

/-- The algebraic map of domain transport agrees with Mathlib's algebraic congruence
after forgetting continuity of the characters. -/
@[to_additive /-- The algebraic map of domain transport agrees with Mathlib's algebraic
congruence after forgetting continuity of the characters. -/]
theorem continuousMonoidHomCongrLeft_toMulEquiv_apply (e : A ≃ₜ* B) (χ : A →ₜ* E) :
    ((continuousMonoidHomCongrLeft E e).toMulEquiv χ).toMonoidHom =
      MulEquiv.monoidHomCongrLeft e.toMulEquiv χ.toMonoidHom := rfl

/-- The inverse algebraic transport agrees with the inverse algebraic congruence. -/
@[to_additive /-- The inverse algebraic transport agrees with the inverse algebraic
congruence. -/]
theorem continuousMonoidHomCongrLeft_symm_toMonoidHom (e : A ≃ₜ* B) (χ : B →ₜ* E) :
    ((continuousMonoidHomCongrLeft E e).symm χ).toMonoidHom =
      (MulEquiv.monoidHomCongrLeft e.toMulEquiv).symm χ.toMonoidHom := rfl

/-- Identity domain transport is the identity continuous multiplicative equivalence. -/
@[to_additive (attr := simp) /-- Identity domain transport is the identity continuous
additive equivalence. -/]
theorem continuousMonoidHomCongrLeft_refl :
    continuousMonoidHomCongrLeft E (ContinuousMulEquiv.refl A) =
      ContinuousMulEquiv.refl (A →ₜ* E) := by
  ext χ a
  rfl

/-- Successive domain transports agree with transport along their composite. -/
@[to_additive /-- Successive domain transports agree with transport along their composite. -/]
theorem continuousMonoidHomCongrLeft_trans (e : A ≃ₜ* B) (f : B ≃ₜ* C) :
    continuousMonoidHomCongrLeft E (e.trans f) =
      (continuousMonoidHomCongrLeft E e).trans (continuousMonoidHomCongrLeft E f) := by
  ext χ c
  rfl

end CommMonoid

section CommGroup

variable [CommGroup E] [TopologicalSpace E] [IsTopologicalGroup E]

/-- Under Mathlib's topological-group hypotheses, domain transport has underlying
continuous homomorphism `compLeft E e.symm`. -/
@[to_additive /-- Under Mathlib's topological additive-group hypotheses, domain transport
has underlying continuous homomorphism `compLeft E e.symm`. -/]
theorem continuousMonoidHomCongrLeft_toContinuousMonoidHom (e : A ≃ₜ* B) :
    (continuousMonoidHomCongrLeft E e : (A →ₜ* E) →ₜ* (B →ₜ* E)) =
      ContinuousMonoidHom.compLeft E (e.symm : B →ₜ* A) := by
  ext χ b
  rfl

end CommGroup

end Domain

section Pi

variable {I : Type u} {A : I → Type v} {B : I → Type w} {C : I → Type z}
variable [∀ i, Mul (A i)] [∀ i, Mul (B i)] [∀ i, Mul (C i)]
variable [∀ i, TopologicalSpace (A i)] [∀ i, TopologicalSpace (B i)]
variable [∀ i, TopologicalSpace (C i)]

/-- A family of continuous multiplicative equivalences induces a continuous
multiplicative equivalence of dependent products, with Mathlib's algebraic Pi data. -/
@[to_additive /-- A family of continuous additive equivalences induces a continuous
additive equivalence of dependent products, with Mathlib's algebraic Pi data. -/]
def piCongrRight (e : ∀ i, A i ≃ₜ* B i) : (∀ i, A i) ≃ₜ* (∀ i, B i) where
  toMulEquiv := MulEquiv.piCongrRight fun i => (e i).toMulEquiv
  continuous_toFun := (Homeomorph.piCongrRight fun i => (e i).toHomeomorph).continuous_toFun
  continuous_invFun := (Homeomorph.piCongrRight fun i => (e i).toHomeomorph).continuous_invFun

@[to_additive (attr := simp)]
theorem piCongrRight_apply (e : ∀ i, A i ≃ₜ* B i) (a : ∀ i, A i) (i : I) :
    piCongrRight e a i = e i (a i) := rfl

@[to_additive (attr := simp)]
theorem piCongrRight_symm_apply (e : ∀ i, A i ≃ₜ* B i) (b : ∀ i, B i) (i : I) :
    (piCongrRight e).symm b i = (e i).symm (b i) := rfl

/-- Forgetting topology gives Mathlib's coordinatewise multiplicative equivalence. -/
@[to_additive (attr := simp) /-- Forgetting topology gives Mathlib's coordinatewise
additive equivalence. -/]
theorem piCongrRight_toMulEquiv (e : ∀ i, A i ≃ₜ* B i) :
    (piCongrRight e : (∀ i, A i) ≃* (∀ i, B i)) =
      MulEquiv.piCongrRight fun i => (e i : A i ≃* B i) := rfl

/-- Forgetting multiplication gives Mathlib's coordinatewise homeomorphism. -/
@[to_additive (attr := simp) /-- Forgetting addition gives Mathlib's coordinatewise
homeomorphism. -/]
theorem piCongrRight_toHomeomorph (e : ∀ i, A i ≃ₜ* B i) :
    (piCongrRight e).toHomeomorph = Homeomorph.piCongrRight fun i => (e i).toHomeomorph := by
  ext a i
  rfl

/-- Coordinatewise identity transport is the identity. -/
@[to_additive (attr := simp) /-- Coordinatewise identity transport is the identity. -/]
theorem piCongrRight_refl :
    (piCongrRight fun i => ContinuousMulEquiv.refl (A i)) =
      ContinuousMulEquiv.refl (∀ i, A i) := by
  ext a i
  rfl

/-- Inverting coordinatewise transport inverts each coordinate equivalence. -/
@[to_additive (attr := simp) /-- Inverting coordinatewise transport inverts each coordinate
 equivalence. -/]
theorem piCongrRight_symm (e : ∀ i, A i ≃ₜ* B i) :
    (piCongrRight e).symm = piCongrRight fun i => (e i).symm := by
  ext b i
  rfl

/-- Composition of coordinatewise transports is coordinatewise composition. -/
@[to_additive /-- Composition of coordinatewise transports is coordinatewise composition. -/]
theorem piCongrRight_trans (e : ∀ i, A i ≃ₜ* B i) (f : ∀ i, B i ≃ₜ* C i) :
    (piCongrRight e).trans (piCongrRight f) = piCongrRight fun i => (e i).trans (f i) := by
  ext a i
  rfl

end Pi

end ContinuousMulEquiv
