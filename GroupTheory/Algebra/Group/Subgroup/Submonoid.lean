module

public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic

/-!
# Cyclic subgroups and submonoids

The cyclic subgroup generated by a submonoid element is contained in the union of the submonoid
and its inverse.
-/

@[expose] public section

/-- Integer powers of a submonoid element lie in the submonoid or its inverse. -/
theorem Submonoid.zpowers_subset_union_inv {G : Type*} [Group G] (S : Submonoid G)
    {x : G} (hx : x ∈ S) :
    (Subgroup.zpowers x : Set G) ⊆ (S : Set G) ∪ Inv.inv '' (S : Set G) := by
  intro y hy
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
  cases n with
  | ofNat n =>
    exact Or.inl ((zpow_natCast x n).symm ▸ S.pow_mem hx n)
  | negSucc n =>
    exact Or.inr ⟨x ^ (n + 1), S.pow_mem hx _, (zpow_negSucc x n).symm⟩
