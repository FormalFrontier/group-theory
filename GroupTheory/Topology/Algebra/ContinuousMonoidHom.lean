module

public import Mathlib.Topology.Algebra.Group.CompactOpen

/-!
# Codomain equivalences of continuous homomorphism spaces

A continuous multiplicative equivalence acts on continuous homomorphisms by
postcomposition. This is a homeomorphism for arbitrary monoids with topologies,
with no continuity assumption on their operations. For commutative codomains with
continuous multiplication, it is a continuous multiplicative equivalence.

The constructions use Mathlib's induced compact-open topology and its continuity
of fixed postcomposition. The multiplicative construction agrees with Mathlib's
`ContinuousMonoidHom.compRight` when the codomains are commutative topological groups.
Additive counterparts are generated by `to_additive`.
-/

@[expose] public section

universe u v w z

namespace ContinuousMulEquiv

variable (A : Type u) [Monoid A] [TopologicalSpace A]
variable {B : Type v} {C : Type w} {D : Type z}
variable [TopologicalSpace B] [TopologicalSpace C] [TopologicalSpace D]

section Monoid

variable [Monoid B] [Monoid C] [Monoid D]

/-- Postcomposition by a continuous multiplicative equivalence is a homeomorphism
of continuous homomorphism spaces, with their induced compact-open topologies. -/
@[to_additive /-- Postcomposition by a continuous additive equivalence is a homeomorphism
of continuous additive homomorphism spaces, with their induced compact-open topologies. -/]
def continuousMonoidHomCongrRightHomeomorph (e : B ≃ₜ* C) :
    (A →ₜ* B) ≃ₜ (A →ₜ* C) where
  toFun χ := (e : B →ₜ* C).comp χ
  invFun χ := (e.symm : C →ₜ* B).comp χ
  left_inv χ := ContinuousMonoidHom.ext fun a => e.symm_apply_apply (χ a)
  right_inv χ := ContinuousMonoidHom.ext fun a => e.apply_symm_apply (χ a)
  continuous_toFun := ContinuousMonoidHom.continuous_comp_right _
  continuous_invFun := ContinuousMonoidHom.continuous_comp_right _

@[to_additive (attr := simp)]
theorem continuousMonoidHomCongrRightHomeomorph_apply (e : B ≃ₜ* C) (χ : A →ₜ* B) :
    continuousMonoidHomCongrRightHomeomorph A e χ = (e : B →ₜ* C).comp χ := rfl

@[to_additive (attr := simp)]
theorem continuousMonoidHomCongrRightHomeomorph_symm_apply (e : B ≃ₜ* C) (χ : A →ₜ* C) :
    (continuousMonoidHomCongrRightHomeomorph A e).symm χ =
      (e.symm : C →ₜ* B).comp χ := rfl

/-- Identity codomain transport induces the identity homeomorphism. -/
@[to_additive (attr := simp) /-- Identity codomain transport induces the identity homeomorphism. -/]
theorem continuousMonoidHomCongrRightHomeomorph_refl :
    continuousMonoidHomCongrRightHomeomorph A (ContinuousMulEquiv.refl B) =
      Homeomorph.refl (A →ₜ* B) := by
  ext χ a
  rfl

/-- Successive codomain transports agree with transport along the composite. -/
@[to_additive /-- Successive codomain transports agree with transport along the composite. -/]
theorem continuousMonoidHomCongrRightHomeomorph_trans (e : B ≃ₜ* C) (f : C ≃ₜ* D) :
    continuousMonoidHomCongrRightHomeomorph A (e.trans f) =
      (continuousMonoidHomCongrRightHomeomorph A e).trans
        (continuousMonoidHomCongrRightHomeomorph A f) := by
  ext χ a
  rfl

end Monoid

section CommMonoid

variable [CommMonoid B] [CommMonoid C] [CommMonoid D]
variable [ContinuousMul B] [ContinuousMul C] [ContinuousMul D]

/-- Postcomposition by a continuous multiplicative equivalence, as a continuous
multiplicative equivalence of continuous homomorphism spaces. -/
@[to_additive /-- Postcomposition by a continuous additive equivalence, as a continuous
additive equivalence of continuous additive homomorphism spaces. -/]
def continuousMonoidHomCongrRight (e : B ≃ₜ* C) : (A →ₜ* B) ≃ₜ* (A →ₜ* C) :=
  ContinuousMulEquiv.mk' (continuousMonoidHomCongrRightHomeomorph A e) (by
    intro χ ψ
    exact ContinuousMonoidHom.ext fun a => map_mul e (χ a) (ψ a))

@[to_additive (attr := simp)]
theorem continuousMonoidHomCongrRight_apply (e : B ≃ₜ* C) (χ : A →ₜ* B) :
    continuousMonoidHomCongrRight A e χ = (e : B →ₜ* C).comp χ := rfl

@[to_additive (attr := simp)]
theorem continuousMonoidHomCongrRight_symm_apply (e : B ≃ₜ* C) (χ : A →ₜ* C) :
    (continuousMonoidHomCongrRight A e).symm χ = (e.symm : C →ₜ* B).comp χ := rfl

/-- Identity codomain transport induces the identity continuous multiplicative equivalence. -/
@[to_additive (attr := simp) /-- Identity codomain transport induces the identity continuous
additive equivalence. -/]
theorem continuousMonoidHomCongrRight_refl :
    continuousMonoidHomCongrRight A (ContinuousMulEquiv.refl B) =
      ContinuousMulEquiv.refl (A →ₜ* B) := by
  ext χ a
  rfl

/-- Successive codomain transports agree with transport along the composite. -/
@[to_additive /-- Successive codomain transports agree with transport along the composite. -/]
theorem continuousMonoidHomCongrRight_trans (e : B ≃ₜ* C) (f : C ≃ₜ* D) :
    continuousMonoidHomCongrRight A (e.trans f) =
      (continuousMonoidHomCongrRight A e).trans (continuousMonoidHomCongrRight A f) := by
  ext χ a
  rfl

end CommMonoid

section CommGroup

variable [CommGroup B] [CommGroup C] [IsTopologicalGroup B] [IsTopologicalGroup C]

/-- For commutative topological groups, the homomorphism underlying codomain transport
is Mathlib's bundled postcomposition map. -/
@[to_additive /-- For commutative topological additive groups, the homomorphism underlying
codomain transport is Mathlib's bundled postcomposition map. -/]
theorem continuousMonoidHomCongrRight_toContinuousMonoidHom (e : B ≃ₜ* C) :
    (continuousMonoidHomCongrRight A e : (A →ₜ* B) →ₜ* (A →ₜ* C)) =
      ContinuousMonoidHom.compRight A (e : B →ₜ* C) := by
  ext χ a
  rfl

end CommGroup

end ContinuousMulEquiv
