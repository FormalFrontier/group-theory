module

public import Mathlib.Algebra.Algebra.Operations
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.RingTheory.Noetherian.Nilpotent
public import GroupTheory.Ring.Nilpotent.Submodule

/-!
# Nilpotence bounds for finitely generated ideals

The total nilpotency class of the ideal generated by a finite set is bounded by one
plus the sum of the predecessors of the generators' total nilpotency classes.
The theorem has no generator-nilpotence hypothesis: a nonnilpotent ideal has total
class zero, while nilpotence of the generated ideal forces every displayed generator
to be nilpotent. Natural-number subtraction accounts for zero generator classes.

The empty generating set gives the zero ideal and an upper bound of one. The theorem
also includes trivial semirings, where the total nilpotency classes are zero.

The bound specializes `Submodule.nilpotencyClass_span_finset_le` to the regular
algebra of a commutative semiring.

This module re-exports `Ideal.FG.isNilpotent_iff_le_nilradical`, the qualitative
criterion for nilpotence of a finitely generated ideal over a commutative semiring.

## References

The total nilpotency class and its power-zero API are from
`Mathlib.RingTheory.Nilpotent.Defs`, formalized by Oliver Nash. The proof uses the
principal-span map `Submodule.spanSingleton` and the span and ideal-sum APIs from
`Mathlib.Algebra.Algebra.Operations` and `Mathlib.RingTheory.Ideal.Operations`.
The finite commuting-sum power bound is
`Finset.sum_pow_eq_zero_of_pairwise_commute` from
`GroupTheory.Ring.Nilpotent.Finset`; its conversion to a class bound uses
`nilpotencyClass_pow` from `GroupTheory.Algebra.GroupWithZero.Nilpotent`.
-/

@[expose] public section

open scoped BigOperators

universe u

namespace Ideal

/-- The total nilpotency class of an ideal generated by a finite set is at most one
plus the sum of the predecessors of the total nilpotency classes of its generators.
No nilpotence hypothesis is required: nonnilpotent ideals have total class zero.
The empty generating set and trivial semirings are included. -/
public theorem nilpotencyClass_span_finset_le
    {R : Type u} [CommSemiring R] (s : Finset R) :
    nilpotencyClass (Ideal.span (↑s : Set R)) ≤
      1 + ∑ x ∈ s, (nilpotencyClass x - 1) := by
  rw [← Ideal.submodule_span_eq]
  exact Submodule.nilpotencyClass_span_finset_le (R := R) s (by
    intro x _ y _ _
    exact Commute.all _ _)

end Ideal
