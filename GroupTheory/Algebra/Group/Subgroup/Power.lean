module

public import Mathlib.Algebra.Group.Subgroup.ZPowers.Lemmas
import Mathlib.Tactic.Lift
import Mathlib.Tactic.NormNum

/-!
# Subgroup membership detected by finite families of powers

For a subgroup-like object in a group, membership of a power at the gcd of a finite
family of natural exponents is equivalent to membership of every power in that family.
Consequently, a family with gcd one detects membership of the element itself. The
additive statements use natural multiples in an additive group.

The ambient group need not be commutative, and the subgroup-like object need not be
normal. Empty families and zero exponents are included. For an empty family, or a family
consisting entirely of zeros, the gcd is zero, and the corresponding zeroth power or zero
multiple belongs to every subgroup-like object.

## References

Mathlib's `Int.closure_eq_zmultiples_finsetGcd` identifies the additive subgroup of the
integers generated by a finite set with the integer multiples of its gcd. The proof
transports this identity through the closure induction principle to powers of an element.
The natural and integer gcds are related by their divisibility universal properties.
-/

@[expose] public section

universe u v w

namespace SubgroupClass

variable {G : Type u} {S : Type v} {ι : Type w}
variable [Group G] [SetLike S G] [SubgroupClass S G]

/-- A power at the gcd of a finite family of natural exponents belongs to a subgroup-like
object if and only if every power in the family does. Empty families and zero exponents
are included. -/
@[to_additive
  /-- A natural multiple at the gcd of a finite family of coefficients belongs to an
  additive subgroup-like object if and only if every multiple in the family does. Empty
  families and zero coefficients are included. -/]
theorem pow_finset_gcd_mem_iff (H : S) (a : G) (s : Finset ι) (e : ι → ℕ) :
    a ^ (s.gcd e) ∈ H ↔ ∀ i ∈ s, a ^ (e i) ∈ H := by
  constructor
  · intro h i hi
    obtain ⟨k, hk⟩ := Finset.gcd_dvd (f := e) hi
    rw [hk, pow_mul]
    exact pow_mem h k
  · intro h
    let t : Finset ℤ := s.image (fun i => (e i : ℤ))
    -- Relate the two gcds by divisibility, without computing either of them.
    lift t.gcd id to ℕ using (Finset.Int.finsetGcd_nonneg (s := t) (f := id)) with d hd
    have hdvd : d ∣ s.gcd e := by
      apply Finset.dvd_gcd
      intro i hi
      have hi' : (e i : ℤ) ∈ t := Finset.mem_image.mpr ⟨i, hi, rfl⟩
      have hdiv : (d : ℤ) ∣ (e i : ℤ) := by
        rw [hd]
        exact Finset.gcd_dvd (f := id) hi'
      exact_mod_cast hdiv
    have hgmem : ((s.gcd e : ℕ) : ℤ) ∈ AddSubgroup.closure (t : Set ℤ) := by
      rw [Int.closure_eq_zmultiples_finsetGcd t, Int.mem_zmultiples_iff, ← hd]
      exact_mod_cast hdvd
    -- Closure induction transports integer linear combinations to powers in H.
    have hpow : a ^ ((s.gcd e : ℕ) : ℤ) ∈ H := by
      generalize hexp : ((s.gcd e : ℕ) : ℤ) = z at hgmem ⊢
      clear hexp
      induction hgmem using AddSubgroup.closure_induction with
      | mem z hz =>
        obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hz
        simpa only [zpow_natCast] using h i hi
      | zero =>
        simpa only [zpow_zero] using (one_mem H : (1 : G) ∈ H)
      | add x y _ _ hx hy =>
        simpa only [zpow_add] using mul_mem hx hy
      | neg x _ hx =>
        simpa only [zpow_neg] using inv_mem hx
    simpa only [zpow_natCast] using hpow

/-- An element belongs to a subgroup-like object if a finite family of its powers belongs
to that object and the exponents have gcd one. -/
@[to_additive mem_of_forall_nsmul_mem_of_gcd_eq_one
  /-- An element belongs to an additive subgroup-like object if a finite family of its
  natural multiples belongs to that object and the coefficients have gcd one. -/]
theorem mem_of_forall_pow_mem_of_gcd_eq_one (H : S) {a : G} {s : Finset ι}
    {e : ι → ℕ} (hg : s.gcd e = 1) (h : ∀ i ∈ s, a ^ (e i) ∈ H) : a ∈ H := by
  have hmem := (pow_finset_gcd_mem_iff H a s e).2 h
  simpa only [hg, pow_one] using hmem

end SubgroupClass

/-- The subgroup generated by a finite family of powers of an element is the cyclic
subgroup generated by the power at the gcd of the exponents. Empty families and zero
exponents are included. -/
@[to_additive
  /-- The additive subgroup generated by a finite family of natural multiples of an
  element is the subgroup of integer multiples of the natural multiple at the gcd of the
  coefficients. Empty families and zero coefficients are included. -/]
theorem Subgroup.closure_pow_image_eq_zpowers_finset_gcd
    {G : Type u} {ι : Type v} [Group G]
    (a : G) (s : Finset ι) (e : ι → ℕ) :
    Subgroup.closure ((fun i => a ^ (e i)) '' (s : Set ι)) =
      Subgroup.zpowers (a ^ (s.gcd e)) := by
  apply le_antisymm
  · apply (Subgroup.closure_le (Subgroup.zpowers (a ^ (s.gcd e)))).2
    rintro _ ⟨i, hi, rfl⟩
    exact (SubgroupClass.pow_finset_gcd_mem_iff
      (Subgroup.zpowers (a ^ (s.gcd e))) a s e).mp
        (Subgroup.mem_zpowers (a ^ (s.gcd e))) i hi
  · apply Subgroup.zpowers_le.mpr
    apply (SubgroupClass.pow_finset_gcd_mem_iff
      (Subgroup.closure ((fun i => a ^ (e i)) '' (s : Set ι))) a s e).mpr
    intro i hi
    exact Subgroup.subset_closure (Set.mem_image_of_mem _ hi)

/-- The intersection of the cyclic subgroups generated by two natural powers of an element
is generated by the power at the least common multiple of the exponents. Zero exponents
are included. -/
@[to_additive
  /-- The intersection of the additive subgroups generated by two natural multiples of an
  element is generated by its multiple at the least common multiple of the coefficients.
  Zero coefficients are included. -/]
theorem Subgroup.zpowers_pow_inf {G : Type u} [Group G] (a : G) (m n : ℕ) :
    Subgroup.zpowers (a ^ m) ⊓ Subgroup.zpowers (a ^ n) =
      Subgroup.zpowers (a ^ (Nat.lcm m n)) := by
  by_cases hm0 : m = 0
  · simp [hm0]
  have hm : m * (n / m.gcd n) = Nat.lcm m n := by
    rw [← Nat.mul_div_assoc m (Nat.gcd_dvd_right m n), Nat.lcm_eq_mul_div]
  have hn : n * (m / m.gcd n) = Nat.lcm m n := by
    rw [← Nat.mul_div_assoc n (Nat.gcd_dvd_left m n), Nat.mul_comm n m,
      Nat.lcm_eq_mul_div]
  apply le_antisymm
  · rintro x ⟨hxm, hxn⟩
    apply SubgroupClass.mem_of_forall_pow_mem_of_gcd_eq_one
      (Subgroup.zpowers (a ^ (Nat.lcm m n)))
      (s := {m / m.gcd n, n / m.gcd n}) (e := id)
    · simpa only [Finset.gcd_insert, Finset.gcd_singleton, id_eq, normalize_eq,
        gcd_eq_nat_gcd] using
        (Nat.gcd_div_gcd_div_gcd_of_pos_left (Nat.pos_of_ne_zero hm0) :
          Nat.gcd (m / m.gcd n) (n / m.gcd n) = 1)
    · intro k hk
      simp only [Finset.mem_insert, Finset.mem_singleton] at hk
      rcases hk with rfl | rfl
      · obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp hxn
        refine Subgroup.mem_zpowers_iff.mpr ⟨i, ?_⟩
        rw [← hn, pow_mul]
        simpa only [id_eq, zpow_natCast, hi] using
          (zpow_comm (a ^ n) ((m / m.gcd n : ℕ) : ℤ) i)
      · obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp hxm
        refine Subgroup.mem_zpowers_iff.mpr ⟨i, ?_⟩
        rw [← hm, pow_mul]
        simpa only [id_eq, zpow_natCast, hi] using
          (zpow_comm (a ^ m) ((n / m.gcd n : ℕ) : ℤ) i)
  · apply le_inf
    · apply Subgroup.zpowers_le.mpr
      obtain ⟨k, hk⟩ := Nat.dvd_lcm_left m n
      exact Subgroup.mem_zpowers_iff.mpr
        ⟨(k : ℤ), by rw [zpow_natCast, ← pow_mul, ← hk]⟩
    · apply Subgroup.zpowers_le.mpr
      obtain ⟨k, hk⟩ := Nat.dvd_lcm_right m n
      exact Subgroup.mem_zpowers_iff.mpr
        ⟨(k : ℤ), by rw [zpow_natCast, ← pow_mul, ← hk]⟩

/-- Intersecting the cyclic subgroup of an element with a finite family of cyclic power
subgroups gives the cyclic subgroup generated by its power at the least common multiple.
The initial intersection includes the empty family; zero exponents are allowed. -/
@[to_additive
  /-- Intersecting the subgroup of integer multiples of an element with a finite family of
  subgroups generated by its natural multiples gives the subgroup generated by its multiple
  at the least common multiple. The initial intersection includes the empty family; zero
  coefficients are allowed. -/]
theorem Subgroup.zpowers_inf_finsetInf_pow
    {G : Type u} {ι : Type v} [Group G]
    (a : G) (s : Finset ι) (e : ι → ℕ) :
    Subgroup.zpowers a ⊓ (s.inf fun i => Subgroup.zpowers (a ^ (e i))) =
      Subgroup.zpowers (a ^ (s.lcm e)) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      simp only [Finset.inf_empty, inf_top_eq, Finset.lcm_empty, pow_one]
  | @insert i s _ ih =>
      rw [Finset.inf_insert, Finset.lcm_insert, inf_left_comm, ih,
        Subgroup.zpowers_pow_inf, lcm_eq_nat_lcm]

/-- The intersection of a nonempty finite family of cyclic power subgroups is generated
by the power at the least common multiple of the exponents. Zero exponents are allowed. -/
@[to_additive
  /-- The intersection of a nonempty finite family of subgroups generated by natural
  multiples of an element is generated by its multiple at the least common multiple of the
  coefficients. Zero coefficients are allowed. -/]
theorem Subgroup.finsetInf_zpowers_pow
    {G : Type u} {ι : Type v} [Group G]
    (a : G) (s : Finset ι) (e : ι → ℕ) (hs : s.Nonempty) :
    (s.inf fun i => Subgroup.zpowers (a ^ (e i))) =
      Subgroup.zpowers (a ^ (s.lcm e)) := by
  obtain ⟨i, hi⟩ := hs
  have hle : (s.inf fun i => Subgroup.zpowers (a ^ (e i))) ≤ Subgroup.zpowers a :=
    (Finset.inf_le (f := fun i => Subgroup.zpowers (a ^ (e i))) hi).trans
      (Subgroup.zpowers_le.mpr (Subgroup.npow_mem_zpowers a (e i)))
  simpa only [inf_eq_right.mpr hle] using Subgroup.zpowers_inf_finsetInf_pow a s e
