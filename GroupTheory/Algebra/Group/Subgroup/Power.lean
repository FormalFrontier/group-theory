module

public import Mathlib.Algebra.Group.Subgroup.ZPowers.Lemmas
import Mathlib.Tactic.Lift
import Mathlib.Tactic.NormNum

/-!
# Subgroup membership detected by finite families of powers

For a subgroup-like object in a group, membership of a power at the gcd of a finite
family of natural exponents is equivalent to membership of every power in that family.
Consequently, a family with gcd one detects membership of the element itself. The
additive statements use natural multiples in an additive group.

The ambient group need not be commutative, and the subgroup-like object need not be
normal. Empty families and zero exponents are included. For an empty family, or a family
consisting entirely of zeros, the gcd is zero, and the corresponding zeroth power or zero
multiple belongs to every subgroup-like object.

## References

Mathlib's `Int.closure_eq_zmultiples_finsetGcd` identifies the additive subgroup of the
integers generated by a finite set with the integer multiples of its gcd. The proof
transports this identity through the closure induction principle to powers of an element.
The natural and integer gcds are related by their divisibility universal properties.
-/

@[expose] public section

universe u v w

namespace SubgroupClass

variable {G : Type u} {S : Type v} {ι : Type w}
variable [Group G] [SetLike S G] [SubgroupClass S G]

/-- A power at the gcd of a finite family of natural exponents belongs to a subgroup-like
object if and only if every power in the family does. Empty families and zero exponents
are included. -/
@[to_additive
  /-- A natural multiple at the gcd of a finite family of coefficients belongs to an
  additive subgroup-like object if and only if every multiple in the family does. Empty
  families and zero coefficients are included. -/]
theorem pow_finset_gcd_mem_iff (H : S) (a : G) (s : Finset ι) (e : ι → ℕ) :
    a ^ (s.gcd e) ∈ H ↔ ∀ i ∈ s, a ^ (e i) ∈ H := by
  constructor
  · intro h i hi
    obtain ⟨k, hk⟩ := Finset.gcd_dvd (f := e) hi
    rw [hk, pow_mul]
    exact pow_mem h k
  · intro h
    let t : Finset ℤ := s.image (fun i => (e i : ℤ))
    -- Relate the two gcds by divisibility, without computing either of them.
    lift t.gcd id to ℕ using (Finset.Int.finsetGcd_nonneg (s := t) (f := id)) with d hd
    have hdvd : d ∣ s.gcd e := by
      apply Finset.dvd_gcd
      intro i hi
      have hi' : (e i : ℤ) ∈ t := Finset.mem_image.mpr ⟨i, hi, rfl⟩
      have hdiv : (d : ℤ) ∣ (e i : ℤ) := by
        rw [hd]
        exact Finset.gcd_dvd (f := id) hi'
      exact_mod_cast hdiv
    have hgmem : ((s.gcd e : ℕ) : ℤ) ∈ AddSubgroup.closure (t : Set ℤ) := by
      rw [Int.closure_eq_zmultiples_finsetGcd t, Int.mem_zmultiples_iff, ← hd]
      exact_mod_cast hdvd
    -- Closure induction transports integer linear combinations to powers in H.
    have hpow : a ^ ((s.gcd e : ℕ) : ℤ) ∈ H := by
      generalize hexp : ((s.gcd e : ℕ) : ℤ) = z at hgmem ⊢
      clear hexp
      induction hgmem using AddSubgroup.closure_induction with
      | mem z hz =>
        obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hz
        simpa only [zpow_natCast] using h i hi
      | zero =>
        simpa only [zpow_zero] using (one_mem H : (1 : G) ∈ H)
      | add x y _ _ hx hy =>
        simpa only [zpow_add] using mul_mem hx hy
      | neg x _ hx =>
        simpa only [zpow_neg] using inv_mem hx
    simpa only [zpow_natCast] using hpow

/-- An element belongs to a subgroup-like object if a finite family of its powers belongs
to that object and the exponents have gcd one. -/
@[to_additive mem_of_forall_nsmul_mem_of_gcd_eq_one
  /-- An element belongs to an additive subgroup-like object if a finite family of its
  natural multiples belongs to that object and the coefficients have gcd one. -/]
theorem mem_of_forall_pow_mem_of_gcd_eq_one (H : S) {a : G} {s : Finset ι}
    {e : ι → ℕ} (hg : s.gcd e = 1) (h : ∀ i ∈ s, a ^ (e i) ∈ H) : a ∈ H := by
  have hmem := (pow_finset_gcd_mem_iff H a s e).2 h
  simpa only [hg, pow_one] using hmem

end SubgroupClass
